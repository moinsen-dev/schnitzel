/// Result of an authentication operation
class AuthResult {
  final bool success;
  final String? accessToken;
  final String? refreshToken;
  final String? error;
  final Map<String, dynamic>? user;

  AuthResult({
    required this.success,
    this.accessToken,
    this.refreshToken,
    this.error,
    this.user,
  });

  factory AuthResult.success({
    required String accessToken,
    required String refreshToken,
    Map<String, dynamic>? user,
  }) {
    return AuthResult(
      success: true,
      accessToken: accessToken,
      refreshToken: refreshToken,
      user: user,
    );
  }

  factory AuthResult.failure(String error) {
    return AuthResult(
      success: false,
      error: error,
    );
  }
}

/// Main authentication client
class AuthClient {
  final Dio _dio;
  final TokenStorage _tokenStorage;
  final LocalAuthentication _localAuth;
{% if auth_config.has_google or auth_config.has_apple or auth_config.has_magic_link %}
  final OAuthHandler _oauthHandler;
{% endif %}

  String? _currentAccessToken;
  String? _currentRefreshToken;
  bool _biometricEnabled = false;

  AuthClient({
    required Dio dio,
    TokenStorage? tokenStorage,
    LocalAuthentication? localAuth,
{% if auth_config.has_google or auth_config.has_apple or auth_config.has_magic_link %}
    OAuthHandler? oauthHandler,
{% endif %}
  })  : _dio = dio,
        _tokenStorage = tokenStorage ?? TokenStorage(),
        _localAuth = localAuth ?? LocalAuthentication(){% if auth_config.has_google or auth_config.has_apple or auth_config.has_magic_link %},
        _oauthHandler = oauthHandler ?? OAuthHandler(){% endif %};

  /// Check if user is currently authenticated
  Future<bool> get isAuthenticated async {
    if (_currentAccessToken != null) {
      return true;
    }

    // Try to load tokens from storage
    final accessToken = await _tokenStorage.getAccessToken();
    if (accessToken != null) {
      _currentAccessToken = accessToken;
      _currentRefreshToken = await _tokenStorage.getRefreshToken();
      return true;
    }

    return false;
  }

  /// Get current access token
  Future<String?> getAccessToken() async {
    if (_currentAccessToken != null) {
      return _currentAccessToken;
    }

    _currentAccessToken = await _tokenStorage.getAccessToken();
    return _currentAccessToken;
  }

  /// Get current refresh token
  Future<String?> getRefreshToken() async {
    if (_currentRefreshToken != null) {
      return _currentRefreshToken;
    }

    _currentRefreshToken = await _tokenStorage.getRefreshToken();
    return _currentRefreshToken;
  }

{% if auth_config.has_email_password %}
  /// Login with email and password
  Future<AuthResult> login({
    required String email,
    required String password,
  }) async {
    try {
      final response = await _dio.post(
        '{{ auth_config.endpoints.login }}',
        data: {
          'email': email,
          'password': password,
        },
      );

      if (response.statusCode == 200) {
        final data = response.data as Map<String, dynamic>;
        final accessToken = data['access_token'] as String?;
        final refreshToken = data['refresh_token'] as String?;
        final user = data['user'] as Map<String, dynamic>?;

        if (accessToken == null || refreshToken == null) {
          return AuthResult.failure('Invalid response from server');
        }

        // Store tokens
        await _tokenStorage.saveTokens(
          accessToken: accessToken,
          refreshToken: refreshToken,
        );

        _currentAccessToken = accessToken;
        _currentRefreshToken = refreshToken;

        return AuthResult.success(
          accessToken: accessToken,
          refreshToken: refreshToken,
          user: user,
        );
      } else {
        return AuthResult.failure('Login failed with status ${response.statusCode}');
      }
    } on DioException catch (e) {
      return AuthResult.failure(_handleDioError(e, 'Login failed'));
    } catch (e) {
      return AuthResult.failure('Unexpected error: $e');
    }
  }

  /// Register a new user with email and password
  Future<AuthResult> register({
    required String email,
    required String password,
    Map<String, dynamic>? additionalData,
  }) async {
    try {
      final data = {
        'email': email,
        'password': password,
        ...?additionalData,
      };

      final response = await _dio.post(
        '{{ auth_config.endpoints.register }}',
        data: data,
      );

      if (response.statusCode == 200 || response.statusCode == 201) {
        final responseData = response.data as Map<String, dynamic>;
        final accessToken = responseData['access_token'] as String?;
        final refreshToken = responseData['refresh_token'] as String?;
        final user = responseData['user'] as Map<String, dynamic>?;

        if (accessToken == null || refreshToken == null) {
          return AuthResult.failure('Invalid response from server');
        }

        // Store tokens
        await _tokenStorage.saveTokens(
          accessToken: accessToken,
          refreshToken: refreshToken,
        );

        _currentAccessToken = accessToken;
        _currentRefreshToken = refreshToken;

        return AuthResult.success(
          accessToken: accessToken,
          refreshToken: refreshToken,
          user: user,
        );
      } else {
        return AuthResult.failure('Registration failed with status ${response.statusCode}');
      }
    } on DioException catch (e) {
      return AuthResult.failure(_handleDioError(e, 'Registration failed'));
    } catch (e) {
      return AuthResult.failure('Unexpected error: $e');
    }
  }
{% endif %}

  /// Refresh access token using refresh token
  Future<AuthResult> refreshToken() async {
    try {
      final refreshToken = await getRefreshToken();
      if (refreshToken == null) {
        return AuthResult.failure('No refresh token available');
      }

      final response = await _dio.post(
        '{{ auth_config.endpoints.refresh }}',
        data: {
          'refresh_token': refreshToken,
        },
      );

      if (response.statusCode == 200) {
        final data = response.data as Map<String, dynamic>;
        final newAccessToken = data['access_token'] as String?;
        final newRefreshToken = data['refresh_token'] as String? ?? refreshToken;

        if (newAccessToken == null) {
          return AuthResult.failure('Invalid response from server');
        }

        // Store new tokens
        await _tokenStorage.saveTokens(
          accessToken: newAccessToken,
          refreshToken: newRefreshToken,
        );

        _currentAccessToken = newAccessToken;
        _currentRefreshToken = newRefreshToken;

        return AuthResult.success(
          accessToken: newAccessToken,
          refreshToken: newRefreshToken,
        );
      } else {
        return AuthResult.failure('Token refresh failed with status ${response.statusCode}');
      }
    } on DioException catch (e) {
      return AuthResult.failure(_handleDioError(e, 'Token refresh failed'));
    } catch (e) {
      return AuthResult.failure('Unexpected error: $e');
    }
  }

  /// Logout and clear all tokens
  ///
  /// Steps:
  /// 1. Get current access and refresh tokens
  /// 2. Call backend logout endpoint with both tokens to revoke them
  /// 3. Clear local token storage
  /// 4. Reset in-memory token references
  Future<void> logout() async {
    try {
      // Get tokens before clearing
      final accessToken = await getAccessToken();
      final refreshToken = await getRefreshToken();

      // Call logout endpoint with refresh token to revoke it on server
      if (accessToken != null) {
        await _dio.post(
          '{{ auth_config.endpoints.logout }}',
          data: {
            'refresh_token': refreshToken,
          },
          options: Options(
            headers: {
              'Authorization': 'Bearer $accessToken',
            },
          ),
        );
      }
    } catch (e) {
      // Ignore errors from logout endpoint
      // Even if server logout fails, we still want to clear local tokens
      print('Logout endpoint error (ignored): $e');
    } finally {
      // Always clear local tokens
      await _tokenStorage.clearTokens();
      _currentAccessToken = null;
      _currentRefreshToken = null;
{% if auth_config.has_google %}

      // Sign out from OAuth providers
      try {
        await _oauthHandler.signOutGoogle();
      } catch (e) {
        print('Google sign-out error (ignored): $e');
      }
{% endif %}
    }
  }

  /// Get current user information
  Future<Map<String, dynamic>?> getCurrentUser() async {
    try {
      final accessToken = await getAccessToken();
      if (accessToken == null) {
        return null;
      }

      final response = await _dio.get(
        '{{ auth_config.endpoints.me }}',
        options: Options(
          headers: {
            'Authorization': 'Bearer $accessToken',
          },
        ),
      );

      if (response.statusCode == 200) {
        return response.data as Map<String, dynamic>?;
      }

      return null;
    } catch (e) {
      print('Get current user error: $e');
      return null;
    }
  }

