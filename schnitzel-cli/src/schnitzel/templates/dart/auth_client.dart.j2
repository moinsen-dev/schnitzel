{% if auth_config.has_magic_link %}
  /// Verify magic link token
  Future<AuthResult> verifyMagicLink(String token) async {
    try {
      final result = await _oauthHandler.handleMagicLink(token);
      if (result.success && result.accessToken != null && result.refreshToken != null) {
        await _tokenStorage.saveTokens(
          accessToken: result.accessToken!,
          refreshToken: result.refreshToken!,
        );
        _currentAccessToken = result.accessToken;
        _currentRefreshToken = result.refreshToken;
      }
      return result;
    } catch (e) {
      return AuthResult.failure('Magic link verification failed: $e');
    }
  }

  /// Request magic link to be sent to email
  Future<bool> requestMagicLink(String email) async {
    try {
      final response = await _dio.post(
        '/auth/magic-link/request',
        data: {'email': email},
      );
      return response.statusCode == 200;
    } catch (e) {
      print('Magic link request error: $e');
      return false;
    }
  }
{% endif %}
}
