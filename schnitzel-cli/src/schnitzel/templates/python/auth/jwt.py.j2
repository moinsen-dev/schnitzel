def create_access_token(
    data: dict,
    expires_delta: timedelta | None = None,
    roles: Optional[list[str]] = None,
    permissions: Optional[list[str]] = None,
    user_id: Optional[str] = None,
    custom_claims: Optional[Dict[str, Any]] = None,
) -> str:
    """Create a JWT access token.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id, "roles": [...], ...}
        expires_delta: Optional custom expiration time. If None, uses default
                      from jwt_config.access_token_expire_minutes.
        roles: Optional list of user roles to include in token
        permissions: Optional list of user permissions to include in token
        user_id: Optional explicit user_id claim
        custom_claims: Optional dictionary of additional custom claims to include in token

    Returns:
        Encoded JWT token string

    Example:
        >>> token = create_access_token(
        ...     {"sub": "user@example.com"},
        ...     roles=["admin"],
        ...     permissions=["read:all", "write:all"]
        ... )
        >>> # Token valid for 15 minutes (default)
        >>>
        >>> token = create_access_token(
        ...     {"sub": "user123"},
        ...     expires_delta=timedelta(hours=1)
        ... )
        >>> # Token valid for 1 hour
        >>>
        >>> token = create_access_token(
        ...     {"sub": "user@example.com"},
        ...     custom_claims={"department": "engineering", "employee_id": "E12345"}
        ... )
        >>> # Token with custom claims
    """
    to_encode = data.copy()

    # Set expiration time
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=jwt_config.access_token_expire_minutes)

    to_encode.update({
        "exp": expire,
        "type": "access",
        "iat": datetime.utcnow(),
    })

    # Add optional claims
    if roles is not None:
        to_encode["roles"] = roles
    if permissions is not None:
        to_encode["permissions"] = permissions
    if user_id is not None:
        to_encode["user_id"] = user_id

    # Add custom claims (before issuer/audience to allow standard claims to take precedence)
    if custom_claims:
        to_encode.update(custom_claims)

    # Add issuer and audience if configured
    if jwt_config.issuer:
        to_encode["iss"] = jwt_config.issuer
    if jwt_config.audience:
        to_encode["aud"] = jwt_config.audience

    # Get signing key based on algorithm
    {% if jwt_config.algorithm.startswith('RS') or jwt_config.algorithm.startswith('ES') %}
    signing_key = get_private_key()
    {% else %}
    signing_key = jwt_config.secret_key
    {% endif %}

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        signing_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


def create_refresh_token(data: dict, user_id: Optional[str] = None) -> str:
    """Create a JWT refresh token.

    Refresh tokens have a longer expiration time and are used to obtain
    new access tokens without requiring re-authentication.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id}
        user_id: Optional explicit user_id claim

    Returns:
        Encoded JWT refresh token string

    Example:
        >>> refresh_token = create_refresh_token({"sub": "user123"})
        >>> # Token valid for 30 days (default)
    """
    to_encode = data.copy()

    # Set expiration time (longer for refresh tokens)
    expire = datetime.utcnow() + timedelta(days=jwt_config.refresh_token_expire_days)

    to_encode.update({
        "exp": expire,
        "type": "refresh",
        "iat": datetime.utcnow(),
    })

    # Add user_id if provided
    if user_id is not None:
        to_encode["user_id"] = user_id

    # Add issuer and audience if configured
    if jwt_config.issuer:
        to_encode["iss"] = jwt_config.issuer
    if jwt_config.audience:
        to_encode["aud"] = jwt_config.audience

    # Get signing key based on algorithm
    {% if jwt_config.algorithm.startswith('RS') or jwt_config.algorithm.startswith('ES') %}
    signing_key = get_private_key()
    {% else %}
    signing_key = jwt_config.secret_key
    {% endif %}

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        signing_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


# =============================================================================
# Token Revocation with Redis Blacklist
# =============================================================================

# Redis client for token blacklist (optional, configure as needed)
_redis_client: Optional[Redis] = None


def get_redis_client() -> Redis:
    """Get or create Redis client for token revocation.

    Returns:
        Redis client instance

    Note:
        Configure Redis connection via environment variables:
        - REDIS_HOST (default: localhost)
        - REDIS_PORT (default: 6379)
        - REDIS_DB (default: 0)
        - REDIS_PASSWORD (optional)
    """
    global _redis_client
    if _redis_client is None:
        import os
        _redis_client = Redis(
            host=os.getenv("REDIS_HOST", "localhost"),
            port=int(os.getenv("REDIS_PORT", "6379")),
            db=int(os.getenv("REDIS_DB", "0")),
            password=os.getenv("REDIS_PASSWORD"),
            decode_responses=True,
        )
    return _redis_client


def revoke_token(token: str, reason: Optional[str] = None) -> bool:
    """Revoke a JWT token by adding it to the Redis blacklist.

    Tokens are stored in Redis with TTL matching their expiration time,
    so they automatically expire from the blacklist when they would
    naturally expire anyway.

    Args:
        token: JWT token string to revoke
        reason: Optional reason for revocation (stored with token)

    Returns:
        True if token was successfully revoked, False otherwise

    Raises:
        RedisError: If Redis operation fails

    Example:
        >>> revoke_token(refresh_token, reason="User logout")
        >>> # Token is now blacklisted and cannot be used
        >>>
        >>> revoke_token(access_token, reason="Security breach detected")
        >>> # Immediately invalidate compromised token

    Note:
        Revoking a token does not affect other tokens for the same user.
        To log out a user completely, revoke both their access and refresh tokens.
    """
    try:
        redis = get_redis_client()

        # Decode token to get expiration (no verification needed for revocation)
        try:
            payload = jwt.decode(
                token,
                options={"verify_signature": False},
            )
        except JWTError:
            # Invalid token format, can't revoke
            return False

        # Calculate TTL from token expiration
        exp = payload.get("exp")
        if not exp:
            # No expiration, use default TTL of 1 day
            ttl = 86400
        else:
            now = datetime.utcnow().timestamp()
            ttl = int(exp - now)

            # If token already expired, no need to blacklist
            if ttl <= 0:
                return True

        # Store in Redis with key: "revoked_token:{token_jti}"
        # Use token itself as key if no jti claim
        token_id = payload.get("jti", token[:32])  # Use first 32 chars if no jti
        redis_key = f"revoked_token:{token_id}"

        # Store with metadata
        revocation_data = {
            "revoked_at": datetime.utcnow().isoformat(),
            "reason": reason or "User initiated",
            "sub": payload.get("sub"),
            "type": payload.get("type"),
        }

        # Use SETEX to set key with TTL
        redis.setex(
            redis_key,
            ttl,
            str(revocation_data)
        )

        return True

    except RedisError as e:
        # Log error (you may want to use a proper logger)
        print(f"Redis error during token revocation: {e}")
        raise


def is_token_revoked(token: str) -> bool:
    """Check if a token has been revoked.

    Args:
        token: JWT token string to check

    Returns:
        True if token is revoked, False otherwise

    Example:
        >>> if is_token_revoked(token):
        ...     raise HTTPException(status_code=401, detail="Token has been revoked")
    """
    try:
        redis = get_redis_client()

        # Decode token without verification to get jti
        try:
            payload = jwt.decode(
                token,
                options={"verify_signature": False},
            )
        except JWTError:
            # Invalid token format
            return False

        # Check if token is in blacklist
        token_id = payload.get("jti", token[:32])
        redis_key = f"revoked_token:{token_id}"

        return redis.exists(redis_key) > 0

    except RedisError as e:
        # Log error
        print(f"Redis error during token revocation check: {e}")
        # Fail open: if Redis is down, don't block all requests
        # You may want to change this behavior based on security requirements
        return False


def revoke_all_user_tokens(user_id: str, ttl: int = 86400) -> bool:
    """Revoke all tokens for a specific user.

    This is useful for forced logout or security incidents.

    Args:
        user_id: User identifier (from token 'sub' claim)
        ttl: Time to live for revocation (default: 24 hours)

    Returns:
        True if successful

    Example:
        >>> revoke_all_user_tokens("user-123")
        >>> # All tokens for user-123 are now invalid

    Note:
        This sets a user-level revocation flag. The verify_token function
        must check both individual token revocation and user-level revocation.
    """
    try:
        redis = get_redis_client()
        redis_key = f"revoked_user:{user_id}"

        # Store revocation timestamp
        revocation_data = {
            "revoked_at": datetime.utcnow().isoformat(),
            "reason": "All user tokens revoked",
        }

        redis.setex(redis_key, ttl, str(revocation_data))
        return True

    except RedisError as e:
        print(f"Redis error during user token revocation: {e}")
        raise


def is_user_revoked(user_id: str) -> bool:
    """Check if all tokens for a user have been revoked.

    Args:
        user_id: User identifier

    Returns:
        True if user's tokens are revoked
    """
    try:
        redis = get_redis_client()
        redis_key = f"revoked_user:{user_id}"
        return redis.exists(redis_key) > 0
    except RedisError:
        return False


