def verify_token(token: str, check_revocation: bool = True) -> dict:
    """Verify and decode a JWT token.

    Args:
        token: JWT token string to verify and decode
        check_revocation: Whether to check if token is revoked (default: True)

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid, expired, or malformed
        ValueError: If the token type is not recognized
        HTTPException: If the token has been revoked

    Example:
        >>> try:
        ...     payload = verify_token(token)
        ...     user_id = payload.get("sub")
        ...     token_type = payload.get("type")
        ... except JWTError:
        ...     # Handle invalid token
        ...     pass
    """
    try:
        # Get verification key based on algorithm
        {% if jwt_config.algorithm.startswith('RS') or jwt_config.algorithm.startswith('ES') %}
        verification_key = get_public_key()
        {% else %}
        verification_key = jwt_config.secret_key
        {% endif %}

        # Prepare decode options
        decode_options = {"algorithms": [jwt_config.algorithm]}
        if jwt_config.audience:
            decode_options["audience"] = jwt_config.audience
        if jwt_config.issuer:
            decode_options["issuer"] = jwt_config.issuer

        # Decode and verify the token
        payload = jwt.decode(
            token,
            verification_key,
            algorithms=[jwt_config.algorithm],
            {% if jwt_config.audience %}
            audience=jwt_config.audience,
            {% endif %}
            {% if jwt_config.issuer %}
            issuer=jwt_config.issuer,
            {% endif %}
        )

        # Verify token type exists
        token_type = payload.get("type")
        if token_type not in ("access", "refresh"):
            raise ValueError(f"Invalid token type: {token_type}")

        # Check if token is revoked (if enabled)
        if check_revocation:
            # Check individual token revocation
            if is_token_revoked(token):
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Token has been revoked",
                    headers={"WWW-Authenticate": "Bearer"},
                )

            # Check user-level revocation
            user_id = payload.get("sub")
            if user_id and is_user_revoked(user_id):
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="All tokens for this user have been revoked",
                    headers={"WWW-Authenticate": "Bearer"},
                )

        return payload

    except JWTError as e:
        # Re-raise JWT errors (invalid signature, expired, etc.)
        raise JWTError(f"Token verification failed: {str(e)}")


def verify_access_token(token: str) -> dict:
    """Verify that a token is a valid access token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not an access token

    Example:
        >>> payload = verify_access_token(token)
        >>> user_id = payload.get("sub")
    """
    payload = verify_token(token)

    if payload.get("type") != "access":
        raise ValueError("Token is not an access token")

    return payload


def verify_refresh_token(token: str) -> dict:
    """Verify that a token is a valid refresh token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not a refresh token

    Example:
        >>> payload = verify_refresh_token(token)
        >>> user_id = payload.get("sub")
        >>> # Generate new access token
        >>> new_access = create_access_token({"sub": user_id})
    """
    payload = verify_token(token)

    if payload.get("type") != "refresh":
        raise ValueError("Token is not a refresh token")

    return payload


# =============================================================================
# Utility Functions
# =============================================================================

def get_user_id_from_token(token: str) -> str | None:
    """Extract user ID from a token.

    Args:
        token: JWT token string

    Returns:
        User ID string if found, None otherwise
    """
    try:
        payload = verify_token(token)
        return payload.get("sub")
    except (JWTError, ValueError):
        return None


def get_user_roles_from_token(token: str) -> list[str]:
    """Extract user roles from a token.

    Args:
        token: JWT token string

    Returns:
        List of role strings (empty list if none found or token invalid)
    """
    try:
        payload = verify_token(token)
        return payload.get("roles", [])
    except (JWTError, ValueError):
        return []


def get_user_permissions_from_token(token: str) -> list[str]:
    """Extract user permissions from a token.

    Args:
        token: JWT token string

    Returns:
        List of permission strings (empty list if none found or token invalid)
    """
    try:
        payload = verify_token(token)
        return payload.get("permissions", [])
    except (JWTError, ValueError):
        return []


def extract_claims_from_token(token: str, claim_keys: list[str]) -> Dict[str, Any]:
    """Extract specific claims from a token.

    Args:
        token: JWT token string
        claim_keys: List of claim keys to extract

    Returns:
        Dictionary with requested claims (empty dict if token invalid)
    """
    try:
        payload = verify_token(token)
        return {key: payload.get(key) for key in claim_keys if key in payload}
    except (JWTError, ValueError):
        return {}


# =============================================================================
# FastAPI Dependency for Token Validation
# =============================================================================

class TokenPayload(BaseModel):
    """Model for decoded token payload.

    This model supports custom claims through Pydantic's extra fields.
    Any additional claims in the token will be available as attributes.
    """
    model_config = {"extra": "allow"}

    sub: str
    exp: int
    iat: int
    type: str
    roles: Optional[list[str]] = None
    permissions: Optional[list[str]] = None
    user_id: Optional[str] = None
    iss: Optional[str] = None
    aud: Optional[str] = None


async def get_current_user(
    credentials: HTTPAuthorizationCredentials = Depends(security),
) -> TokenPayload:
    """FastAPI dependency to get the current authenticated user from JWT token.

    Extracts the JWT token from the Authorization header (Bearer scheme),
    validates it, and returns the decoded payload.

    Args:
        credentials: HTTP Bearer credentials from the Authorization header

    Returns:
        TokenPayload object containing the decoded token claims

    Raises:
        HTTPException: 401 Unauthorized if token is missing, invalid, or expired

    Example:
        >>> from fastapi import Depends
        >>>
        >>> @app.get("/profile")
        >>> async def get_profile(current_user: TokenPayload = Depends(get_current_user)):
        ...     user_id = current_user.sub
        ...     roles = current_user.roles
        ...     return {"user_id": user_id, "roles": roles}
    """
    token = credentials.credentials

    try:
        # Verify and decode the token
        payload = verify_access_token(token)

        # Create TokenPayload from decoded claims
        return TokenPayload(**payload)

    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=f"Invalid token: {str(e)}",
            headers={"WWW-Authenticate": "Bearer"},
        )
    except JWTError as e:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=f"Could not validate credentials: {str(e)}",
            headers={"WWW-Authenticate": "Bearer"},
        )


async def get_current_user_with_roles(
    required_roles: list[str],
) -> callable:
    """Create a dependency that checks for specific roles.

    Args:
        required_roles: List of roles that the user must have at least one of

    Returns:
        FastAPI dependency function

    Example:
        >>> admin_only = get_current_user_with_roles(["admin"])
        >>>
        >>> @app.delete("/users/{user_id}")
        >>> async def delete_user(
        ...     user_id: str,
        ...     current_user: TokenPayload = Depends(admin_only)
        ... ):
        ...     # Only admins can access this endpoint
        ...     pass
    """
    async def dependency(current_user: TokenPayload = Depends(get_current_user)) -> TokenPayload:
        if not current_user.roles:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="User has no roles assigned",
            )

        # Check if user has any of the required roles
        user_roles = set(current_user.roles)
        required_roles_set = set(required_roles)

        if not user_roles.intersection(required_roles_set):
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=f"User does not have required role. Required: {required_roles}",
            )

        return current_user

    return dependency


async def get_current_user_with_permissions(
    required_permissions: list[str],
) -> callable:
    """Create a dependency that checks for specific permissions.

    Args:
        required_permissions: List of permissions that the user must have all of

    Returns:
        FastAPI dependency function

    Example:
        >>> write_orders = get_current_user_with_permissions(["write:orders"])
        >>>
        >>> @app.post("/orders")
        >>> async def create_order(
        ...     order_data: dict,
        ...     current_user: TokenPayload = Depends(write_orders)
        ... ):
        ...     # Only users with write:orders permission can access
        ...     pass
    """
    async def dependency(current_user: TokenPayload = Depends(get_current_user)) -> TokenPayload:
        if not current_user.permissions:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="User has no permissions assigned",
            )

        # Check if user has all required permissions
        user_permissions = set(current_user.permissions)
        required_permissions_set = set(required_permissions)

        if not required_permissions_set.issubset(user_permissions):
            missing = required_permissions_set - user_permissions
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=f"User missing required permissions: {list(missing)}",
            )

        return current_user

    return dependency
