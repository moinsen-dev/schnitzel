# FastAPI Dependency for Token Validation
# =============================================================================

class TokenPayload(BaseModel):
    """Model for decoded token payload."""

    sub: str
    exp: int
    iat: int
    type: str
    roles: Optional[list[str]] = None
    permissions: Optional[list[str]] = None
    user_id: Optional[str] = None
    iss: Optional[str] = None
    aud: Optional[str] = None


async def get_current_user(
    credentials: HTTPAuthorizationCredentials = Depends(security),
) -> TokenPayload:
    """FastAPI dependency to get the current authenticated user from JWT token.

    Extracts the JWT token from the Authorization header (Bearer scheme),
    validates it, and returns the decoded payload.

    Args:
        credentials: HTTP Bearer credentials from the Authorization header

    Returns:
        TokenPayload object containing the decoded token claims

    Raises:
        HTTPException: 401 Unauthorized if token is missing, invalid, or expired

    Example:
        >>> from fastapi import Depends
        >>>
        >>> @app.get("/profile")
        >>> async def get_profile(current_user: TokenPayload = Depends(get_current_user)):
        ...     user_id = current_user.sub
        ...     roles = current_user.roles
        ...     return {"user_id": user_id, "roles": roles}
    """
    token = credentials.credentials

    try:
        # Verify and decode the token
        payload = verify_access_token(token)

        # Create TokenPayload from decoded claims
        return TokenPayload(**payload)

    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=f"Invalid token: {str(e)}",
            headers={"WWW-Authenticate": "Bearer"},
        )
    except JWTError as e:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=f"Could not validate credentials: {str(e)}",
            headers={"WWW-Authenticate": "Bearer"},
        )


async def get_current_user_with_roles(
    required_roles: list[str],
) -> callable:
    """Create a dependency that checks for specific roles.

    Args:
        required_roles: List of roles that the user must have at least one of

    Returns:
        FastAPI dependency function

    Example:
        >>> admin_only = get_current_user_with_roles(["admin"])
        >>>
        >>> @app.delete("/users/{user_id}")
        >>> async def delete_user(
        ...     user_id: str,
        ...     current_user: TokenPayload = Depends(admin_only)
        ... ):
        ...     # Only admins can access this endpoint
        ...     pass
    """
    async def dependency(current_user: TokenPayload = Depends(get_current_user)) -> TokenPayload:
        if not current_user.roles:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="User has no roles assigned",
            )

        # Check if user has any of the required roles
        user_roles = set(current_user.roles)
        required_roles_set = set(required_roles)

        if not user_roles.intersection(required_roles_set):
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=f"User does not have required role. Required: {required_roles}",
            )

        return current_user

    return dependency


async def get_current_user_with_permissions(
    required_permissions: list[str],
) -> callable:
    """Create a dependency that checks for specific permissions.

    Args:
        required_permissions: List of permissions that the user must have all of

    Returns:
        FastAPI dependency function

    Example:
        >>> write_orders = get_current_user_with_permissions(["write:orders"])
        >>>
        >>> @app.post("/orders")
        >>> async def create_order(
        ...     order_data: dict,
        ...     current_user: TokenPayload = Depends(write_orders)
        ... ):
        ...     # Only users with write:orders permission can access
        ...     pass
    """
    async def dependency(current_user: TokenPayload = Depends(get_current_user)) -> TokenPayload:
        if not current_user.permissions:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="User has no permissions assigned",
            )

        # Check if user has all required permissions
        user_permissions = set(current_user.permissions)
        required_permissions_set = set(required_permissions)

        if not required_permissions_set.issubset(user_permissions):
            missing = required_permissions_set - user_permissions
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail=f"User missing required permissions: {list(missing)}",
            )

        return current_user

    return dependency
