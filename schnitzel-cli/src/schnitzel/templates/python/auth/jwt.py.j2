def get_user_id_from_token(token: str) -> str | None:
    """Extract user ID from a token.

    Args:
        token: JWT token string

    Returns:
        User ID string if found, None otherwise
    """
    try:
        payload = verify_token(token)
        return payload.get("sub")
    except (JWTError, ValueError):
        return None


def get_user_roles_from_token(token: str) -> list[str]:
    """Extract user roles from a token.

    Args:
        token: JWT token string

    Returns:
        List of role strings (empty list if none found or token invalid)
    """
    try:
        payload = verify_token(token)
        return payload.get("roles", [])
    except (JWTError, ValueError):
        return []


def get_user_permissions_from_token(token: str) -> list[str]:
    """Extract user permissions from a token.

    Args:
        token: JWT token string

    Returns:
        List of permission strings (empty list if none found or token invalid)
    """
    try:
        payload = verify_token(token)
        return payload.get("permissions", [])
    except (JWTError, ValueError):
        return []


def extract_claims_from_token(token: str, claim_keys: list[str]) -> Dict[str, Any]:
    """Extract specific claims from a token.

    Args:
        token: JWT token string
        claim_keys: List of claim keys to extract

    Returns:
        Dictionary with requested claims (empty dict if token invalid)
    """
    try:
        payload = verify_token(token)
        return {key: payload.get(key) for key in claim_keys if key in payload}
    except (JWTError, ValueError):
        return {}


