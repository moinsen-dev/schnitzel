def load_private_key(key_path: str) -> bytes:
    """Load ECDSA private key from file for token signing.

    Args:
        key_path: Path to PEM-encoded ECDSA private key file

    Returns:
        Private key in PEM format as bytes

    Example:
        >>> private_key = load_private_key("keys/private_ec.pem")

    Note:
        For ES256, use NIST P-256 curve (secp256r1 / prime256v1)
        For ES384, use NIST P-384 curve (secp384r1)
        For ES512, use NIST P-521 curve (secp521r1)
    """
    with open(key_path, "rb") as key_file:
        private_key = serialization.load_pem_private_key(
            key_file.read(),
            password=None,
            backend=default_backend()
        )
    return private_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )


def load_public_key(key_path: str) -> bytes:
    """Load ECDSA public key from file for token verification.

    Args:
        key_path: Path to PEM-encoded ECDSA public key file

    Returns:
        Public key in PEM format as bytes

    Example:
        >>> public_key = load_public_key("keys/public_ec.pem")
    """
    with open(key_path, "rb") as key_file:
        public_key = serialization.load_pem_public_key(
            key_file.read(),
            backend=default_backend()
        )
    return public_key.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.SubjectPublicKeyInfo()
    )


def generate_ecdsa_keypair() -> tuple[bytes, bytes]:
    """Generate a new ECDSA key pair for JWT signing.

    Returns:
        Tuple of (private_key_pem, public_key_pem)

    Example:
        >>> private_pem, public_pem = generate_ecdsa_keypair()
        >>> # Save to files
        >>> with open("keys/private_ec.pem", "wb") as f:
        ...     f.write(private_pem)
        >>> with open("keys/public_ec.pem", "wb") as f:
        ...     f.write(public_pem)

    Note:
        This generates keys for the configured algorithm:
        - ES256 uses NIST P-256 curve (secp256r1)
        - ES384 uses NIST P-384 curve (secp384r1)
        - ES512 uses NIST P-521 curve (secp521r1)
    """
    # Select curve based on algorithm
    {% if jwt_config.algorithm == 'ES256' %}
    curve = ec.SECP256R1()
    {% elif jwt_config.algorithm == 'ES384' %}
    curve = ec.SECP384R1()
    {% elif jwt_config.algorithm == 'ES512' %}
    curve = ec.SECP521R1()
    {% else %}
    # Default to P-256 for ES256
    curve = ec.SECP256R1()
    {% endif %}

    # Generate private key
    private_key = ec.generate_private_key(curve, default_backend())

    # Extract public key
    public_key = private_key.public_key()

    # Serialize to PEM format
    private_pem = private_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )

    public_pem = public_key.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.SubjectPublicKeyInfo()
    )

    return private_pem, public_pem
{% endif %}

