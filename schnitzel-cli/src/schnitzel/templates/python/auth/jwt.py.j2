def validate_jwt_environment() -> None:
    """Validate required JWT environment variables at startup.

    Checks for required environment variables based on JWT algorithm configuration.
    Raises SystemExit with clear error message if required variables are missing.

    Required Variables:
        - JWT_SECRET (required for HS256, HS384, HS512 algorithms)
{% if jwt_config.algorithm.startswith('RS') or jwt_config.algorithm.startswith('ES') %}
        - JWT_PRIVATE_KEY_PATH (required for {{ jwt_config.algorithm }} algorithm)
        - JWT_PUBLIC_KEY_PATH (required for {{ jwt_config.algorithm }} algorithm)
{% endif %}
        - REDIS_URL (required for token revocation, optional otherwise)

    Usage:
        Call this function during application startup:

        >>> # In main.py or app initialization
        >>> from .generated.auth.jwt import validate_jwt_environment
        >>> validate_jwt_environment()

        Or use as a FastAPI lifespan event:

        >>> from fastapi import FastAPI
        >>> from contextlib import asynccontextmanager
        >>>
        >>> @asynccontextmanager
        >>> async def lifespan(app: FastAPI):
        >>>     validate_jwt_environment()
        >>>     yield
        >>>
        >>> app = FastAPI(lifespan=lifespan)
    """
    required_vars = []
    missing_vars = []

{% if jwt_config.algorithm in ['HS256', 'HS384', 'HS512'] %}
    # HS256/384/512 requires JWT_SECRET
    required_vars.append("JWT_SECRET")
    if not os.getenv("JWT_SECRET"):
        missing_vars.append("JWT_SECRET")
