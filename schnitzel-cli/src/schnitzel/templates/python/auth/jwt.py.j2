"""Generated JWT authentication utilities from Schnitzel schema."""

from datetime import datetime, timedelta
from typing import Any, Dict, Optional

from jose import JWTError, jwt
from pydantic import BaseModel


# =============================================================================
# Configuration
# =============================================================================

class JWTConfig(BaseModel):
    """JWT configuration from schema."""

    secret_key: str = "{{ jwt_config.secret_key | default('your-secret-key-here-change-in-production') }}"
    algorithm: str = "{{ jwt_config.algorithm | default('HS256') }}"
    access_token_expire_minutes: int = {{ jwt_config.access_expiry | default(15) }}
    refresh_token_expire_days: int = {{ jwt_config.refresh_expiry | default(30) }}


# Default configuration (can be overridden)
jwt_config = JWTConfig()


# =============================================================================
# JWT Token Generation
# =============================================================================

def create_access_token(data: dict, expires_delta: timedelta | None = None) -> str:
    """Create a JWT access token.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id, "roles": [...], ...}
        expires_delta: Optional custom expiration time. If None, uses default
                      from jwt_config.access_token_expire_minutes.

    Returns:
        Encoded JWT token string

    Example:
        >>> token = create_access_token({"sub": "user123", "roles": ["user"]})
        >>> # Token valid for 15 minutes (default)
        >>>
        >>> token = create_access_token(
        ...     {"sub": "user123"},
        ...     expires_delta=timedelta(hours=1)
        ... )
        >>> # Token valid for 1 hour
    """
    to_encode = data.copy()

    # Set expiration time
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=jwt_config.access_token_expire_minutes)

    to_encode.update({"exp": expire, "type": "access"})

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        jwt_config.secret_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


def create_refresh_token(data: dict) -> str:
    """Create a JWT refresh token.

    Refresh tokens have a longer expiration time and are used to obtain
    new access tokens without requiring re-authentication.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id}

    Returns:
        Encoded JWT refresh token string

    Example:
        >>> refresh_token = create_refresh_token({"sub": "user123"})
        >>> # Token valid for 30 days (default)
    """
    to_encode = data.copy()

    # Set expiration time (longer for refresh tokens)
    expire = datetime.utcnow() + timedelta(days=jwt_config.refresh_token_expire_days)

    to_encode.update({"exp": expire, "type": "refresh"})

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        jwt_config.secret_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


# =============================================================================
# JWT Token Verification
# =============================================================================

def verify_token(token: str) -> dict:
    """Verify and decode a JWT token.

    Args:
        token: JWT token string to verify and decode

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid, expired, or malformed
        ValueError: If the token type is not recognized

    Example:
        >>> try:
        ...     payload = verify_token(token)
        ...     user_id = payload.get("sub")
        ...     token_type = payload.get("type")
        ... except JWTError:
        ...     # Handle invalid token
        ...     pass
    """
    try:
        # Decode and verify the token
        payload = jwt.decode(
            token,
            jwt_config.secret_key,
            algorithms=[jwt_config.algorithm]
        )

        # Verify token type exists
        token_type = payload.get("type")
        if token_type not in ("access", "refresh"):
            raise ValueError(f"Invalid token type: {token_type}")

        return payload

    except JWTError as e:
        # Re-raise JWT errors (invalid signature, expired, etc.)
        raise JWTError(f"Token verification failed: {str(e)}")


def verify_access_token(token: str) -> dict:
    """Verify that a token is a valid access token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not an access token

    Example:
        >>> payload = verify_access_token(token)
        >>> user_id = payload.get("sub")
    """
    payload = verify_token(token)

    if payload.get("type") != "access":
        raise ValueError("Token is not an access token")

    return payload


def verify_refresh_token(token: str) -> dict:
    """Verify that a token is a valid refresh token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not a refresh token

    Example:
        >>> payload = verify_refresh_token(token)
        >>> user_id = payload.get("sub")
        >>> # Generate new access token
        >>> new_access = create_access_token({"sub": user_id})
    """
    payload = verify_token(token)

    if payload.get("type") != "refresh":
        raise ValueError("Token is not a refresh token")

    return payload


# =============================================================================
# Utility Functions
# =============================================================================

def get_user_id_from_token(token: str) -> str | None:
    """Extract user ID from a token.

    Args:
        token: JWT token string

    Returns:
        User ID string if found, None otherwise
    """
    try:
        payload = verify_token(token)
        return payload.get("sub")
    except (JWTError, ValueError):
        return None


def get_user_roles_from_token(token: str) -> list[str]:
    """Extract user roles from a token.

    Args:
        token: JWT token string

    Returns:
        List of role strings (empty list if none found or token invalid)
    """
    try:
        payload = verify_token(token)
        return payload.get("roles", [])
    except (JWTError, ValueError):
        return []
