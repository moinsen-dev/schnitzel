# =============================================================================
# RSA Key Loading (for RS256, RS384, RS512)
# =============================================================================

def load_private_key(key_path: str) -> bytes:
    """Load RSA private key from file for token signing.

    Args:
        key_path: Path to PEM-encoded private key file

    Returns:
        Private key in PEM format as bytes

    Example:
        >>> private_key = load_private_key("keys/private.pem")
    """
    with open(key_path, "rb") as key_file:
        private_key = serialization.load_pem_private_key(
            key_file.read(),
            password=None,
            backend=default_backend()
        )
    return private_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )


def load_public_key(key_path: str) -> bytes:
    """Load RSA public key from file for token verification.

    Args:
        key_path: Path to PEM-encoded public key file

    Returns:
        Public key in PEM format as bytes

    Example:
        >>> public_key = load_public_key("keys/public.pem")
    """
    with open(key_path, "rb") as key_file:
        public_key = serialization.load_pem_public_key(
            key_file.read(),
            backend=default_backend()
        )
    return public_key.public_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.SubjectPublicKeyInfo()
    )


# Cache for loaded keys (load once, reuse)
_private_key: Optional[bytes] = None
_public_key: Optional[bytes] = None


def get_private_key() -> bytes:
    """Get cached private key or load from environment variable JWT_PRIVATE_KEY_PATH."""
    global _private_key
    if _private_key is None:
        import os
        key_path = os.getenv("JWT_PRIVATE_KEY_PATH", "keys/private.pem")
        _private_key = load_private_key(key_path)
    return _private_key


def get_public_key() -> bytes:
    """Get cached public key or load from environment variable JWT_PUBLIC_KEY_PATH."""
    global _public_key
    if _public_key is None:
        import os
        key_path = os.getenv("JWT_PUBLIC_KEY_PATH", "keys/public.pem")
        _public_key = load_public_key(key_path)
    return _public_key

