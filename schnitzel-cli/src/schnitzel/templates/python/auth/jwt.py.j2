# =============================================================================
# Claims Management
# =============================================================================

def build_token_claims(
    subject: str,
    token_type: str = "access",
    roles: Optional[list[str]] = None,
    permissions: Optional[list[str]] = None,
    user_id: Optional[str] = None,
    custom_claims: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    """Build standard and custom JWT claims.

    Args:
        subject: The subject claim (typically user identifier)
        token_type: Type of token ("access" or "refresh")
        roles: Optional list of user roles
        permissions: Optional list of user permissions
        user_id: Optional explicit user_id claim
        custom_claims: Optional dictionary of additional custom claims

    Returns:
        Dictionary containing all claims to be encoded in the token

    Example:
        >>> claims = build_token_claims(
        ...     subject="user@example.com",
        ...     roles=["admin", "user"],
        ...     permissions=["read:orders", "write:orders"],
        ...     user_id="uuid-123"
        ... )
    """
    claims: Dict[str, Any] = {
        "sub": subject,
        "iat": datetime.utcnow(),
        "type": token_type,
    }

    # Add issuer and audience if configured
    if jwt_config.issuer:
        claims["iss"] = jwt_config.issuer
    if jwt_config.audience:
        claims["aud"] = jwt_config.audience

    # Add optional standard claims
    if roles is not None:
        claims["roles"] = roles
    if permissions is not None:
        claims["permissions"] = permissions
    if user_id is not None:
        claims["user_id"] = user_id

    # Merge custom claims
    if custom_claims:
        claims.update(custom_claims)

    return claims


