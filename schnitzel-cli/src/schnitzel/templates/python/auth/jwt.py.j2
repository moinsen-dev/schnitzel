# =============================================================================
# Claims Management
# =============================================================================

def build_token_claims(
    subject: str,
    token_type: str = "access",
    roles: Optional[list[str]] = None,
    permissions: Optional[list[str]] = None,
    user_id: Optional[str] = None,
    custom_claims: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    """Build standard and custom JWT claims.

    Args:
        subject: The subject claim (typically user identifier)
        token_type: Type of token ("access" or "refresh")
        roles: Optional list of user roles
        permissions: Optional list of user permissions
        user_id: Optional explicit user_id claim
        custom_claims: Optional dictionary of additional custom claims

    Returns:
        Dictionary containing all claims to be encoded in the token

    Example:
        >>> claims = build_token_claims(
        ...     subject="user@example.com",
        ...     roles=["admin", "user"],
        ...     permissions=["read:orders", "write:orders"],
        ...     user_id="uuid-123"
        ... )
    """
    claims: Dict[str, Any] = {
        "sub": subject,
        "iat": datetime.utcnow(),
        "type": token_type,
    }

    # Add issuer and audience if configured
    if jwt_config.issuer:
        claims["iss"] = jwt_config.issuer
    if jwt_config.audience:
        claims["aud"] = jwt_config.audience

    # Add optional standard claims
    if roles is not None:
        claims["roles"] = roles
    if permissions is not None:
        claims["permissions"] = permissions
    if user_id is not None:
        claims["user_id"] = user_id

    # Merge custom claims
    if custom_claims:
        claims.update(custom_claims)

    return claims


# =============================================================================
# JWT Token Generation
# =============================================================================

def create_access_token(
    data: dict,
    expires_delta: timedelta | None = None,
    roles: Optional[list[str]] = None,
    permissions: Optional[list[str]] = None,
    user_id: Optional[str] = None,
) -> str:
    """Create a JWT access token.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id, "roles": [...], ...}
        expires_delta: Optional custom expiration time. If None, uses default
                      from jwt_config.access_token_expire_minutes.
        roles: Optional list of user roles to include in token
        permissions: Optional list of user permissions to include in token
        user_id: Optional explicit user_id claim

    Returns:
        Encoded JWT token string

    Example:
        >>> token = create_access_token(
        ...     {"sub": "user@example.com"},
        ...     roles=["admin"],
        ...     permissions=["read:all", "write:all"]
        ... )
        >>> # Token valid for 15 minutes (default)
        >>>
        >>> token = create_access_token(
        ...     {"sub": "user123"},
        ...     expires_delta=timedelta(hours=1)
        ... )
        >>> # Token valid for 1 hour
    """
    to_encode = data.copy()

    # Set expiration time
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=jwt_config.access_token_expire_minutes)

    to_encode.update({
        "exp": expire,
        "type": "access",
        "iat": datetime.utcnow(),
    })

    # Add optional claims
    if roles is not None:
        to_encode["roles"] = roles
    if permissions is not None:
        to_encode["permissions"] = permissions
    if user_id is not None:
        to_encode["user_id"] = user_id

    # Add issuer and audience if configured
    if jwt_config.issuer:
        to_encode["iss"] = jwt_config.issuer
    if jwt_config.audience:
        to_encode["aud"] = jwt_config.audience

    # Get signing key based on algorithm
    {% if jwt_config.algorithm.startswith('RS') %}
    signing_key = get_private_key()
    {% else %}
    signing_key = jwt_config.secret_key
    {% endif %}

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        signing_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


def create_refresh_token(data: dict, user_id: Optional[str] = None) -> str:
    """Create a JWT refresh token.

    Refresh tokens have a longer expiration time and are used to obtain
    new access tokens without requiring re-authentication.

    Args:
        data: Dictionary containing claims to encode in the token.
              Typically includes: {"sub": user_id}
        user_id: Optional explicit user_id claim

    Returns:
        Encoded JWT refresh token string

    Example:
        >>> refresh_token = create_refresh_token({"sub": "user123"})
        >>> # Token valid for 30 days (default)
    """
    to_encode = data.copy()

    # Set expiration time (longer for refresh tokens)
    expire = datetime.utcnow() + timedelta(days=jwt_config.refresh_token_expire_days)

    to_encode.update({
        "exp": expire,
        "type": "refresh",
        "iat": datetime.utcnow(),
    })

    # Add user_id if provided
    if user_id is not None:
        to_encode["user_id"] = user_id

    # Add issuer and audience if configured
    if jwt_config.issuer:
        to_encode["iss"] = jwt_config.issuer
    if jwt_config.audience:
        to_encode["aud"] = jwt_config.audience

    # Get signing key based on algorithm
    {% if jwt_config.algorithm.startswith('RS') %}
    signing_key = get_private_key()
    {% else %}
    signing_key = jwt_config.secret_key
    {% endif %}

    # Encode the JWT
    encoded_jwt = jwt.encode(
        to_encode,
        signing_key,
        algorithm=jwt_config.algorithm
    )

    return encoded_jwt


# =============================================================================
# JWT Token Verification
# =============================================================================

def verify_token(token: str) -> dict:
    """Verify and decode a JWT token.

    Args:
        token: JWT token string to verify and decode

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid, expired, or malformed
        ValueError: If the token type is not recognized

    Example:
        >>> try:
        ...     payload = verify_token(token)
        ...     user_id = payload.get("sub")
        ...     token_type = payload.get("type")
        ... except JWTError:
        ...     # Handle invalid token
        ...     pass
    """
    try:
        # Get verification key based on algorithm
        {% if jwt_config.algorithm.startswith('RS') %}
        verification_key = get_public_key()
        {% else %}
        verification_key = jwt_config.secret_key
        {% endif %}

        # Prepare decode options
        decode_options = {"algorithms": [jwt_config.algorithm]}
        if jwt_config.audience:
            decode_options["audience"] = jwt_config.audience
        if jwt_config.issuer:
            decode_options["issuer"] = jwt_config.issuer

        # Decode and verify the token
        payload = jwt.decode(
            token,
            verification_key,
            algorithms=[jwt_config.algorithm],
            {% if jwt_config.audience %}
            audience=jwt_config.audience,
            {% endif %}
            {% if jwt_config.issuer %}
            issuer=jwt_config.issuer,
            {% endif %}
        )

        # Verify token type exists
        token_type = payload.get("type")
        if token_type not in ("access", "refresh"):
            raise ValueError(f"Invalid token type: {token_type}")

        return payload

    except JWTError as e:
        # Re-raise JWT errors (invalid signature, expired, etc.)
        raise JWTError(f"Token verification failed: {str(e)}")


def verify_access_token(token: str) -> dict:
    """Verify that a token is a valid access token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not an access token

    Example:
        >>> payload = verify_access_token(token)
        >>> user_id = payload.get("sub")
    """
    payload = verify_token(token)

    if payload.get("type") != "access":
        raise ValueError("Token is not an access token")

    return payload


def verify_refresh_token(token: str) -> dict:
    """Verify that a token is a valid refresh token.

    Args:
        token: JWT token string to verify

    Returns:
        Dictionary containing the decoded token claims

    Raises:
        JWTError: If the token is invalid or expired
        ValueError: If the token is not a refresh token

    Example:
        >>> payload = verify_refresh_token(token)
        >>> user_id = payload.get("sub")
        >>> # Generate new access token
        >>> new_access = create_access_token({"sub": user_id})
    """
    payload = verify_token(token)

    if payload.get("type") != "refresh":
        raise ValueError("Token is not a refresh token")

    return payload


# =============================================================================
# Utility Functions
