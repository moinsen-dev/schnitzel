# =============================================================================
# MFA Enrollment Flow (auth_053)
# =============================================================================

def start_mfa_enrollment(user_id: str, email: str) -> dict[str, Any]:
    """Start MFA enrollment process for a user.

    Generates all required MFA data (secret, QR code, backup codes) and
    stores them in pending state. The user must verify a TOTP code before
    MFA is fully enabled.

    Args:
        user_id: User's unique identifier
        email: User's email address for TOTP URI

    Returns:
        Dictionary containing:
        - secret: TOTP secret (show to user as fallback)
        - qr_code: PNG image bytes (base64 encode before sending to client)
        - backup_codes: List of plaintext backup codes (show once to user)

    Raises:
        Exception: If database operation fails

    Example:
        >>> enrollment_data = start_mfa_enrollment("user-123", "user@example.com")
        >>>
        >>> # Return to client
        >>> return {
        ...     "secret": enrollment_data["secret"],
        ...     "qr_code": base64.b64encode(enrollment_data["qr_code"]).decode(),
        ...     "backup_codes": enrollment_data["backup_codes"]
        ... }
        >>>
        >>> # User should scan QR code and verify with complete_mfa_setup()
    """
    # Generate TOTP secret
    secret = generate_totp_secret()

    # Generate URI for QR code
    uri = generate_totp_uri(secret, email)

    # Generate QR code image
    qr_code = generate_qr_code(uri)

    # Generate backup codes
    backup_codes = generate_backup_codes()

    # Hash backup codes for storage
    hashed_codes = hash_backup_codes(backup_codes)

    # Store in database as pending
    store_pending_mfa(user_id, secret, hashed_codes)

    return {
        "secret": secret,
        "qr_code": qr_code,
        "backup_codes": backup_codes,  # Return plaintext codes to show user once
    }


# =============================================================================
# MFA Setup Completion (auth_055)
# =============================================================================

def complete_mfa_setup(user_id: str, totp_code: str) -> bool:
    """Complete MFA setup by verifying a TOTP code.

    Verifies that the user can generate valid TOTP codes before enabling MFA.
    This prevents users from locking themselves out due to setup errors.

    Args:
        user_id: User's unique identifier
        totp_code: 6-digit TOTP code from user's authenticator app

    Returns:
        True if code is valid and MFA was enabled, False if code is invalid

    Raises:
        ValueError: If user has no pending MFA setup
        Exception: If database operation fails

    Example:
        >>> # After start_mfa_enrollment(), user scans QR code
        >>> code = "123456"  # User enters from authenticator app
        >>>
        >>> if complete_mfa_setup("user-123", code):
        ...     print("MFA enabled successfully!")
        ... else:
        ...     print("Invalid code. Please try again.")
    """
    # Get pending secret from database
    secret = get_user_mfa_secret(user_id)

    if not secret:
        raise ValueError("No pending MFA setup found for user")

    # Verify the TOTP code
    is_valid = verify_totp(secret, totp_code)

    if is_valid:
        # Code is valid - enable MFA for user
        enable_mfa_for_user(user_id)
        return True

    return False


# =============================================================================
# MFA Verification Middleware (auth_054)
# =============================================================================

async def require_mfa(
    request: Request,
    user_id: Optional[str] = None
) -> dict[str, Any]:
    """FastAPI dependency to require MFA verification.

    Checks if the user has MFA enabled and if they have verified their
    MFA code in the current session. Raises HTTPException if MFA is
    required but not verified.

    Args:
        request: FastAPI request object (for session access)
        user_id: User's unique identifier (usually from auth dependency)

    Returns:
        Dictionary with user_id and mfa_verified status

    Raises:
        HTTPException(403): If MFA is required but not verified

    Usage:
        >>> from fastapi import Depends
        >>>
        >>> @app.get("/protected")
        >>> async def protected_route(
        ...     mfa_check: dict = Depends(require_mfa)
        ... ):
        ...     return {"message": "Access granted"}
        >>>
        >>> # Or with custom auth dependency
        >>> async def get_current_user(token: str) -> dict:
        ...     # ... verify token and get user_id
        ...     return {"user_id": "user-123"}
        >>>
        >>> @app.get("/protected")
        >>> async def protected_route(
        ...     user: dict = Depends(get_current_user),
        ...     mfa_check: dict = Depends(require_mfa)
        ... ):
        ...     return {"message": "Access granted"}
    """
    # If no user_id provided, try to get from request state
    if user_id is None:
        user_id = getattr(request.state, "user_id", None)

    if not user_id:
        raise HTTPException(
            status_code=403,
            detail="Authentication required"
        )

    # Check if user has MFA enabled
    mfa_enabled = is_user_mfa_enabled(user_id)

    if not mfa_enabled:
        # MFA not enabled for this user - allow access
        return {"user_id": user_id, "mfa_verified": False}

    # Check if MFA has been verified in this session
    session = getattr(request.state, "session", {})
    mfa_verified = session.get("mfa_verified", False)
    mfa_user_id = session.get("mfa_user_id")

    if not mfa_verified or mfa_user_id != user_id:
        raise HTTPException(
            status_code=403,
            detail="MFA verification required. Please verify your MFA code."
        )

    return {"user_id": user_id, "mfa_verified": True}


