# =============================================================================
# TOTP Secret Generation
# =============================================================================

def generate_totp_secret(length: int = 32) -> str:
    """Generate a base32-encoded TOTP secret.

    Creates a cryptographically secure random secret that can be used
    for TOTP (Time-based One-Time Password) authentication.

    Args:
        length: Length of the secret in bytes (default: 32, which produces
                a 52-character base32 string). Must be at least 16 bytes
                for security. Recommended: 32 bytes.

    Returns:
        Base32-encoded secret string (no padding characters)

    Raises:
        ValueError: If length is less than 16 bytes

    Example:
        >>> secret = generate_totp_secret()
        >>> # Example output: "JBSWY3DPEHPK3PXP"
        >>> # Save this secret securely in your database
    """
    if length < 16:
        raise ValueError("TOTP secret must be at least 16 bytes for security")

    # Generate cryptographically secure random bytes
    random_bytes = secrets.token_bytes(length)

    # Encode to base32 (without padding for cleaner storage)
    secret = pyotp.random_base32(length)

    return secret


# =============================================================================
# TOTP Verification
# =============================================================================

def verify_totp(secret: str, code: str, window: int = 1) -> bool:
    """Verify a TOTP code against a secret.

    Validates a 6-digit TOTP code provided by the user against the stored
    secret. Includes a time window to account for clock drift.

    Args:
        secret: Base32-encoded TOTP secret (stored in database)
        code: 6-digit TOTP code provided by the user
        window: Number of time periods to check before and after current time
                (default: 1, which checks 3 periods total: -30s, current, +30s)
                Increase if users report validation issues, but larger windows
                reduce security.

    Returns:
        True if the code is valid, False otherwise

    Raises:
        ValueError: If secret is empty or code format is invalid

    Example:
        >>> secret = "JBSWY3DPEHPK3PXP"
        >>> user_code = "123456"  # From authenticator app
        >>>
        >>> if verify_totp(secret, user_code):
        ...     print("Valid code!")
        ... else:
        ...     print("Invalid code!")
    """
    if not secret:
        raise ValueError("TOTP secret cannot be empty")

    if not code or not code.isdigit() or len(code) != 6:
        raise ValueError("TOTP code must be a 6-digit number")

    # Create TOTP instance with the secret
    totp = pyotp.TOTP(secret)

    # Verify the code with the specified time window
    is_valid = totp.verify(code, valid_window=window)

    return is_valid


# =============================================================================
# TOTP URI Generation (for QR Codes)
# =============================================================================

def generate_totp_uri(
    secret: str,
    email: str,
    issuer: Optional[str] = None
) -> str:
    """Generate an otpauth:// URI for TOTP setup.

    Creates a standardized URI that can be encoded into a QR code for
    easy setup in authenticator apps (Google Authenticator, Authy, etc.).

    Args:
        secret: Base32-encoded TOTP secret
        email: User's email address or account identifier
        issuer: Optional issuer name (defaults to mfa_config.totp_issuer)
                Shown in authenticator apps as the service name

    Returns:
        otpauth:// URI string suitable for QR code generation

    Raises:
        ValueError: If secret or email is empty

    Example:
        >>> secret = "JBSWY3DPEHPK3PXP"
        >>> uri = generate_totp_uri(secret, "user@example.com", "MyApp")
        >>> # URI: otpauth://totp/MyApp:user@example.com?secret=JBSWY3DPEHPK3PXP&issuer=MyApp
    """
    if not secret:
        raise ValueError("TOTP secret cannot be empty")

    if not email:
        raise ValueError("Email cannot be empty")

    # Use configured issuer if not provided
    if issuer is None:
        issuer = mfa_config.totp_issuer

    # Create TOTP instance
    totp = pyotp.TOTP(secret)

    # Generate provisioning URI
    uri = totp.provisioning_uri(
        name=email,
        issuer_name=issuer
    )

    return uri


# =============================================================================
# QR Code Generation
# =============================================================================

def generate_qr_code(uri: str, box_size: int = 10, border: int = 4) -> bytes:
    """Generate a QR code image from an otpauth:// URI.

    Creates a PNG image of a QR code that users can scan with their
    authenticator app to set up TOTP.

    Args:
        uri: otpauth:// URI from generate_totp_uri()
        box_size: Size of each box in pixels (default: 10)
                  Larger values create bigger QR codes
        border: Width of the border in boxes (default: 4)
                QR code spec requires minimum 4

    Returns:
        PNG image data as bytes, ready to send to client or save to file

    Raises:
        ValueError: If URI is empty

    Example:
        >>> secret = generate_totp_secret()
        >>> uri = generate_totp_uri(secret, "user@example.com")
        >>> qr_bytes = generate_qr_code(uri)
        >>>
        >>> # Send to client
        >>> return Response(content=qr_bytes, media_type="image/png")
        >>>
        >>> # Or save to file
        >>> with open("qrcode.png", "wb") as f:
        ...     f.write(qr_bytes)
    """
    if not uri:
        raise ValueError("URI cannot be empty")

    # Create QR code instance
    qr = qrcode.QRCode(
        version=1,  # Auto-adjust size based on data
        error_correction=qrcode.constants.ERROR_CORRECT_L,
        box_size=box_size,
        border=border,
    )

    # Add data to the QR code
    qr.add_data(uri)
    qr.make(fit=True)

    # Create image
    img = qr.make_image(fill_color="black", back_color="white")

    # Convert to PNG bytes
    buffer = io.BytesIO()
    img.save(buffer, format="PNG")
    qr_bytes = buffer.getvalue()

    return qr_bytes


# =============================================================================
# Backup Codes Generation
# =============================================================================

def generate_backup_codes(count: Optional[int] = None) -> list[str]:
    """Generate backup codes for account recovery.

    Creates a list of one-time use backup codes that users can use
    if they lose access to their authenticator device.

    Args:
        count: Number of backup codes to generate
               (defaults to mfa_config.backup_codes_count)

    Returns:
        List of backup code strings (format: XXXX-XXXX)

    Example:
        >>> codes = generate_backup_codes(10)
        >>> # Example codes: ["A3F2-9B8C", "7D4E-1F6A", ...]
        >>> # Store these securely (hashed) in your database
    """
    if count is None:
        count = mfa_config.backup_codes_count

    codes = []
    for _ in range(count):
        # Generate 8 random hex characters
        code_bytes = secrets.token_bytes(4)
        code_hex = code_bytes.hex().upper()

        # Format as XXXX-XXXX
        formatted_code = f"{code_hex[:4]}-{code_hex[4:]}"
        codes.append(formatted_code)

    return codes


def hash_backup_codes(codes: list[str]) -> list[str]:
    """Hash backup codes for secure storage.

    Hashes each backup code using SHA-256 so they can be stored safely
    in the database without exposing the actual codes.

    Args:
        codes: List of plaintext backup codes

    Returns:
        List of hashed backup codes (hex encoded)

    Example:
        >>> codes = generate_backup_codes(10)
        >>> hashed = hash_backup_codes(codes)
        >>> # Store hashed codes in database
        >>> user.backup_codes = hashed
    """
    hashed = []
    for code in codes:
        # Normalize and hash the code
        normalized = code.strip().upper()
        hash_obj = hashlib.sha256(normalized.encode('utf-8'))
        hashed.append(hash_obj.hexdigest())
    return hashed


def verify_backup_code(code: str, hashed_codes: list[str]) -> tuple[bool, list[str]]:
    """Verify a backup code against stored hashed codes.

    Checks if the provided backup code matches any of the hashed codes.
    Uses constant-time comparison to prevent timing attacks.
    Returns remaining codes after removing the used one.

    Args:
        code: Backup code provided by user (format: XXXX-XXXX)
        hashed_codes: List of hashed backup codes from database

    Returns:
        Tuple of (is_valid, remaining_codes):
        - is_valid: True if the code matches, False otherwise
        - remaining_codes: List of remaining hashed codes (excluding used one)

    Note:
        Always update the database with the remaining_codes after verification
        to ensure each backup code can only be used once.

    Example:
        >>> hashed_codes = hash_backup_codes(["A3F2-9B8C", "7D4E-1F6A"])
        >>> user_code = "A3F2-9B8C"
        >>>
        >>> is_valid, remaining = verify_backup_code(user_code, hashed_codes)
        >>> if is_valid:
        ...     # Update database with remaining codes
        ...     user.backup_codes = remaining
        ...     print("Valid backup code!")
    """
    if not code:
        return False, hashed_codes

    # Normalize input (remove spaces, convert to uppercase)
    normalized_code = code.strip().upper()

    # Hash the provided code
    hash_obj = hashlib.sha256(normalized_code.encode('utf-8'))
    code_hash = hash_obj.hexdigest()

    # Check against each stored code using constant-time comparison
    for i, stored_hash in enumerate(hashed_codes):
        if secrets.compare_digest(code_hash, stored_hash):
            # Code is valid - remove it from the list
            remaining_codes = hashed_codes[:i] + hashed_codes[i+1:]
            return True, remaining_codes

    # Code not found
    return False, hashed_codes


