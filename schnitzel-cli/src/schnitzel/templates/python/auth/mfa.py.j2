# Complete MFA Setup Flow
# =============================================================================

def setup_mfa_for_user(email: str) -> dict:
    """Complete MFA setup flow for a user.

    Generates a secret, URI, QR code, and backup codes in one call.
    Convenient for initial MFA setup endpoints.

    Args:
        email: User's email address

    Returns:
        Dictionary containing:
        - secret: TOTP secret (store this in database)
        - uri: otpauth:// URI
        - qr_code: PNG image bytes
        - backup_codes: List of backup codes (hash before storing)

    Example:
        >>> mfa_data = setup_mfa_for_user("user@example.com")
        >>>
        >>> # Store in database
        >>> user.mfa_secret = mfa_data["secret"]
        >>> user.backup_codes = [hash_code(code) for code in mfa_data["backup_codes"]]
        >>>
        >>> # Return QR code to user
        >>> return {
        ...     "qr_code": base64.b64encode(mfa_data["qr_code"]).decode(),
        ...     "backup_codes": mfa_data["backup_codes"]
        ... }
    """
    # Generate TOTP secret
    secret = generate_totp_secret()

    # Generate URI for QR code
    uri = generate_totp_uri(secret, email)

    # Generate QR code image
    qr_code = generate_qr_code(uri)

    # Generate backup codes
    backup_codes = generate_backup_codes()

    return {
        "secret": secret,
        "uri": uri,
        "qr_code": qr_code,
        "backup_codes": backup_codes,
    }


