# =============================================================================
# OAuth State Management (CSRF Protection) - auth_105
# =============================================================================

# Redis client for OAuth state storage (optional, configure as needed)
_oauth_redis_client: Optional[Redis] = None


def get_oauth_redis_client() -> Redis:
    """Get or create Redis client for OAuth state storage.

    Returns:
        Redis client instance

    Note:
        Configure Redis connection via environment variables:
        - REDIS_HOST (default: localhost)
        - REDIS_PORT (default: 6379)
        - REDIS_DB (default: 0)
        - REDIS_PASSWORD (optional)
    """
    global _oauth_redis_client
    if _oauth_redis_client is None:
        _oauth_redis_client = Redis(
            host=os.getenv("REDIS_HOST", "localhost"),
            port=int(os.getenv("REDIS_PORT", "6379")),
            db=int(os.getenv("REDIS_DB", "0")),
            password=os.getenv("REDIS_PASSWORD"),
            decode_responses=True,
        )
    return _oauth_redis_client


def generate_oauth_state(provider: str, ttl: int = 300) -> str:
    """Generate and store OAuth state parameter for CSRF protection.

    State is stored in Redis with TTL (default 5 minutes) to prevent
    replay attacks and clean up stale states automatically.

    Args:
        provider: OAuth provider name (google, apple, github, etc.)
        ttl: Time to live in seconds (default: 300 = 5 minutes)

    Returns:
        State token string (URL-safe random token)

    Raises:
        RedisError: If Redis storage fails

    Example:
        >>> state = generate_oauth_state("google")
        >>> auth_url = get_google_auth_url(state=state)
        >>> # User is redirected to auth_url
        >>> # On callback, validate state with validate_oauth_state_redis()

    Note:
        The state is automatically deleted from Redis after TTL expires
        or after successful validation.
    """
    try:
        redis = get_oauth_redis_client()

        # Generate cryptographically secure random state
        state = secrets.token_urlsafe(32)

        # Store state in Redis with TTL
        redis_key = f"oauth_state:{state}"
        state_data = {
            "provider": provider,
            "created_at": datetime.utcnow().isoformat(),
        }

        # Use SETEX to set key with expiry
        redis.setex(redis_key, ttl, str(state_data))

        return state

    except RedisError as e:
        print(f"Redis error during OAuth state generation: {e}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Failed to generate OAuth state"
        )


def validate_oauth_state_redis(state: str, expected_provider: Optional[str] = None) -> bool:
    """Validate OAuth state parameter from callback against stored state in Redis.

    Checks that:
    1. State exists in Redis (not expired, not reused)
    2. State matches expected provider (if specified)

    After validation, the state is deleted to prevent replay attacks.

    Args:
        state: State parameter from OAuth callback
        expected_provider: Expected OAuth provider (optional validation)

    Returns:
        True if state is valid

    Raises:
        HTTPException: If state is invalid or expired

    Example:
        >>> # In callback handler:
        >>> validate_oauth_state_redis(state, expected_provider="google")
        >>> # Proceed with OAuth code exchange

    Security:
        - Automatically deletes state after validation (single-use)
        - States expire after TTL (default 5 minutes)
        - Prevents replay attacks and CSRF
    """
    try:
        redis = get_oauth_redis_client()

        # Check if state exists in Redis
        redis_key = f"oauth_state:{state}"
        state_data = redis.get(redis_key)

        if not state_data:
            # State not found or expired
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Invalid or expired OAuth state parameter"
            )

        # Validate provider if specified
        if expected_provider:
            # Parse state data (stored as string representation of dict)
            if expected_provider not in str(state_data):
                raise HTTPException(
                    status_code=status.HTTP_400_BAD_REQUEST,
                    detail=f"OAuth state does not match expected provider: {expected_provider}"
                )

        # Delete state to prevent replay attacks (single-use token)
        redis.delete(redis_key)

        return True

    except RedisError as e:
        print(f"Redis error during OAuth state validation: {e}")
        # Fail secure: if Redis is down, reject the state
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Failed to validate OAuth state"
        )


