def register_user(email: str, password: str) -> Dict[str, Any]:
    """Register a new user with email and password.

    Creates a new user account with hashed password and returns JWT tokens.

    Args:
        email: User's email address
        password: Plain text password (will be hashed)

    Returns:
        Dictionary with user info and tokens: {user, access_token, refresh_token}

    Raises:
        HTTPException: 400 if user already exists

    Example:
        >>> result = register_user("user@example.com", "secure-password")
        >>> access_token = result["access_token"]
        >>> user_id = result["user"]["id"]
    """
    # Check if user already exists
    existing_user = _get_user_by_email(email)
    if existing_user:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="User with this email already exists"
        )

    # Hash the password
    password_hash = hash_password(password)

    # Create user in database
    user = _create_user(email=email, password_hash=password_hash, provider="email_password")

    # Generate JWT tokens
    tokens = create_tokens(user["id"], user["email"])

    return {
        "user": {
            "id": user["id"],
            "email": user["email"],
        },
        "access_token": tokens["access_token"],
        "refresh_token": tokens["refresh_token"],
    }


def login_user(email: str, password: str) -> Dict[str, Any]:
    """Authenticate user with email and password.

    Verifies credentials and returns JWT tokens on success.

    Args:
        email: User's email address
        password: Plain text password

    Returns:
        Dictionary with user info and tokens: {user, access_token, refresh_token}

    Raises:
        HTTPException: 401 if credentials are invalid

    Example:
        >>> result = login_user("user@example.com", "password")
        >>> access_token = result["access_token"]
    """
    # Get user from database
    user = _get_user_by_email(email)
    if not user:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid email or password"
        )

    # Verify password
    if not user.get("password_hash"):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="This account uses OAuth login. Please use the appropriate provider."
        )

    if not verify_password(password, user["password_hash"]):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid email or password"
        )

    # Generate JWT tokens
    tokens = create_tokens(user["id"], user["email"])

    return {
        "user": {
            "id": user["id"],
            "email": user["email"],
        },
        "access_token": tokens["access_token"],
        "refresh_token": tokens["refresh_token"],
    }

