# PKCE (Proof Key for Code Exchange) for Mobile Apps (auth_106)
# =============================================================================

def generate_pkce_code_verifier() -> str:
    """Generate a PKCE code verifier for mobile OAuth flows.

    The code verifier is a high-entropy cryptographic random string using
    unreserved characters [A-Z] / [a-z] / [0-9] / "-" / "." / "_" / "~"
    with a minimum length of 43 characters and maximum length of 128 characters.

    Returns:
        Base64url-encoded code verifier (43-128 characters)

    Example:
        >>> code_verifier = generate_pkce_code_verifier()
        >>> # Store code_verifier securely in session/secure storage
        >>> # Use generate_pkce_code_challenge(code_verifier) for auth request
    """
    # Generate 32 random bytes (will be ~43 chars when base64url encoded)
    code_verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode('utf-8')
    # Remove padding
    return code_verifier.rstrip('=')


def generate_pkce_code_challenge(code_verifier: str, method: str = "S256") -> str:
    """Generate a PKCE code challenge from a code verifier.

    Supports two methods:
    - S256: SHA256 hash of the verifier (recommended, more secure)
    - plain: Verifier itself (not recommended, use only if S256 not supported)

    Args:
        code_verifier: The code verifier to transform
        method: Challenge method - "S256" (default) or "plain"

    Returns:
        Base64url-encoded code challenge

    Raises:
        ValueError: If method is not "S256" or "plain"

    Example:
        >>> verifier = generate_pkce_code_verifier()
        >>> challenge = generate_pkce_code_challenge(verifier, method="S256")
        >>> # Include challenge in authorization URL
        >>> # Store verifier securely for token exchange
    """
    if method == "S256":
        # SHA256 hash of the code verifier
        digest = hashlib.sha256(code_verifier.encode('utf-8')).digest()
        # Base64url encode without padding
        challenge = base64.urlsafe_b64encode(digest).decode('utf-8').rstrip('=')
        return challenge
    elif method == "plain":
        # Plain method: challenge = verifier
        return code_verifier
    else:
        raise ValueError(f"Invalid PKCE method: {method}. Must be 'S256' or 'plain'")


def validate_pkce_code_verifier(code_verifier: str, code_challenge: str, method: str = "S256") -> bool:
    """Validate a PKCE code verifier against the stored code challenge.

    This function should be called in the OAuth callback to verify that the
    code_verifier provided by the client matches the code_challenge that was
    used during the initial authorization request.

    Args:
        code_verifier: Code verifier from client (token exchange request)
        code_challenge: Code challenge from initial auth request (stored server-side)
        method: Challenge method used - "S256" (default) or "plain"

    Returns:
        True if verifier is valid, False otherwise

    Example:
        >>> # In authorization endpoint:
        >>> verifier = generate_pkce_code_verifier()
        >>> challenge = generate_pkce_code_challenge(verifier)
        >>> # Store challenge with auth code
        >>>
        >>> # In token exchange endpoint:
        >>> if validate_pkce_code_verifier(provided_verifier, stored_challenge):
        ...     # Proceed with token exchange
        ...     pass
    """
    try:
        computed_challenge = generate_pkce_code_challenge(code_verifier, method)
        return secrets.compare_digest(computed_challenge, code_challenge)
    except Exception:
        return False


def _store_pkce_verifier(session_key: str, code_verifier: str) -> None:
    """Store PKCE code verifier securely for later validation.

    This is a stub function that should be implemented with your secure storage layer
