def get_apple_auth_url(state: Optional[str] = None) -> str:
    """Generate Apple Sign In authorization URL.

    Args:
        state: Optional state parameter for CSRF protection. If None, generates random state.

    Returns:
        Authorization URL string

    Example:
        >>> auth_url = get_apple_auth_url(state="random-state-123")
        >>> # Redirect user to auth_url
    """
    if state is None:
        state = secrets.token_urlsafe(32)

    params = {
        "client_id": oauth_config.apple_client_id,
        "redirect_uri": oauth_config.apple_redirect_uri,
        "response_type": "code id_token",
        "response_mode": "form_post",
        "scope": "name email",
        "state": state,
    }

    base_url = "https://appleid.apple.com/auth/authorize"
    return f"{base_url}?{urlencode(params)}"


async def apple_callback(code: str, id_token: Optional[str] = None) -> Dict[str, Any]:
    """Exchange authorization code for tokens and extract user info.

    Apple Sign In returns an id_token which contains user information.
    The code can be exchanged for an access token if needed for additional API calls.

    Args:
        code: Authorization code from Apple callback
        id_token: Optional ID token from Apple (contains user info)

    Returns:
        Dictionary containing tokens and user info

    Raises:
        httpx.HTTPError: If token exchange fails
        JWTError: If ID token decoding fails

    Example:
        >>> result = await apple_callback(code="auth-code-123", id_token="jwt-token")
        >>> print(result["user_info"]["email"])
    """
    # Decode ID token to get user info
    user_info = {}
    if id_token:
        user_info = decode_apple_id_token(id_token)

    # Exchange code for access token (optional, for future API calls)
    token_url = "https://appleid.apple.com/auth/token"
    token_data = {
        "code": code,
        "client_id": oauth_config.apple_client_id,
        "client_secret": _generate_apple_client_secret(),
        "grant_type": "authorization_code",
        "redirect_uri": oauth_config.apple_redirect_uri,
    }

    async with httpx.AsyncClient() as client:
        token_response = await client.post(token_url, data=token_data)
        token_response.raise_for_status()
        tokens = token_response.json()

        return {
            "access_token": tokens.get("access_token"),
            "refresh_token": tokens.get("refresh_token"),
            "expires_in": tokens.get("expires_in"),
            "user_info": user_info,
        }


def decode_apple_id_token(id_token: str) -> Dict[str, Any]:
    """Decode and validate Apple ID token (JWT).

    Note: In production, you should verify the token signature against Apple's public keys.
    This implementation does basic decoding without signature verification.

    Args:
        id_token: JWT ID token from Apple

    Returns:
        Dictionary with user claims (sub, email, email_verified, etc.)

    Raises:
        JWTError: If token is invalid or expired

    Example:
        >>> user_info = decode_apple_id_token(id_token)
        >>> print(f"Apple User ID: {user_info['sub']}")
        >>> print(f"Email: {user_info['email']}")
    """
    try:
        # Decode without verification (verify signature in production!)
        # For production, fetch Apple's public keys and verify signature
        payload = jwt.decode(
            id_token,
            options={"verify_signature": False},  # TODO: Verify in production
        )

        return {
            "id": payload.get("sub"),
            "email": payload.get("email"),
            "email_verified": payload.get("email_verified", False),
            "is_private_email": payload.get("is_private_email", False),
        }
    except JWTError as e:
        raise JWTError(f"Failed to decode Apple ID token: {str(e)}")


def _generate_apple_client_secret() -> str:
    """Generate Apple client secret JWT.

    Apple requires a JWT signed with your private key as the client secret.

    Returns:
        Signed JWT to use as client_secret

    Note:
        Requires APPLE_TEAM_ID, APPLE_KEY_ID, and APPLE_PRIVATE_KEY to be configured.
    """
    now = datetime.utcnow()
    expiration = now + timedelta(days=180)  # Max 6 months

    claims = {
        "iss": oauth_config.apple_team_id,
        "iat": int(now.timestamp()),
        "exp": int(expiration.timestamp()),
        "aud": "https://appleid.apple.com",
        "sub": oauth_config.apple_client_id,
    }

    headers = {
        "kid": oauth_config.apple_key_id,
        "alg": "ES256",
    }

    # Sign with private key
    client_secret = jwt.encode(
        claims,
        oauth_config.apple_private_key,
        algorithm="ES256",
        headers=headers,
    )

    return client_secret

