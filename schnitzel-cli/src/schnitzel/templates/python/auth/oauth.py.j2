{% if oauth_config.has_magic_link %}

def generate_magic_link(email: str) -> tuple[str, str]:
    """Generate a magic link token for passwordless authentication.

    Creates a signed JWT token containing the user's email and expiration time.

    Args:
        email: User's email address

    Returns:
        Tuple of (token, magic_link_url)

    Example:
        >>> token, link = generate_magic_link("user@example.com")
        >>> # Send link via email to user
        >>> print(f"Magic link: {link}")
    """
    # Generate token with email and expiration
    expiration = datetime.utcnow() + timedelta(
        minutes=oauth_config.magic_link_expiry_minutes
    )

    payload = {
        "email": email,
        "exp": expiration,
        "type": "magic_link",
    }

    token = jwt.encode(
        payload,
        oauth_config.magic_link_secret,
        algorithm="HS256",
    )

    # Build magic link URL
    base_url = "{{ oauth_config.callback_url }}/magic-link/verify"
    magic_link_url = f"{base_url}?token={token}"

    return token, magic_link_url


def verify_magic_link(token: str) -> str:
    """Verify a magic link token and extract the email.

    Args:
        token: Magic link token to verify

    Returns:
        Email address from the token

    Raises:
        JWTError: If token is invalid or expired
        ValueError: If token type is not magic_link

    Example:
        >>> try:
        ...     email = verify_magic_link(token)
        ...     # Authenticate user with this email
        ... except JWTError:
        ...     # Token invalid or expired
        ...     pass
    """
    try:
        payload = jwt.decode(
            token,
            oauth_config.magic_link_secret,
            algorithms=["HS256"],
        )

        # Verify token type
        if payload.get("type") != "magic_link":
            raise ValueError("Invalid token type")

        email = payload.get("email")
        if not email:
            raise ValueError("Email not found in token")

        return email

    except JWTError as e:
        raise JWTError(f"Magic link verification failed: {str(e)}")


