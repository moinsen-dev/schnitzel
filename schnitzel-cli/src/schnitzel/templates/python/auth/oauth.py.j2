def get_or_create_user(provider: str, email: str, provider_id: str) -> Dict[str, Any]:
    """Get existing user or create new one from OAuth provider data.

    If a user with this email exists, links the OAuth provider to their account.
    If no user exists, creates a new user with the OAuth provider.

    Args:
        provider: OAuth provider name ("google", "apple", etc.)
        email: User's email from OAuth provider
        provider_id: Provider-specific user ID

    Returns:
        Dictionary with user info and tokens: {user, access_token, refresh_token}

    Example:
        >>> result = get_or_create_user("google", "user@example.com", "google-123")
        >>> user_id = result["user"]["id"]
        >>> access_token = result["access_token"]
    """
    # Check if user exists with this email
    user = _get_user_by_email(email)

    if user:
        # User exists - link OAuth provider if not already linked
        if user.get("provider") != provider or user.get("provider_id") != provider_id:
            _link_oauth_provider(user["id"], provider, provider_id)
    else:
        # Create new user with OAuth provider
        user = _create_user(
            email=email,
            provider=provider,
            provider_id=provider_id
        )

    # Generate JWT tokens
    tokens = create_tokens(user["id"], user["email"])

    return {
        "user": {
            "id": user["id"],
            "email": user["email"],
            "provider": provider,
        },
        "access_token": tokens["access_token"],
        "refresh_token": tokens["refresh_token"],
    }


