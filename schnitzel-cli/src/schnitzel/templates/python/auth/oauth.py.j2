def decode_apple_id_token(id_token: str) -> Dict[str, Any]:
    """Decode and validate Apple ID token (JWT).

    Note: In production, you should verify the token signature against Apple's public keys.
    This implementation does basic decoding without signature verification.

    Args:
        id_token: JWT ID token from Apple

    Returns:
        Dictionary with user claims (sub, email, email_verified, etc.)

    Raises:
        JWTError: If token is invalid or expired

    Example:
        >>> user_info = decode_apple_id_token(id_token)
        >>> print(f"Apple User ID: {user_info['sub']}")
        >>> print(f"Email: {user_info['email']}")
    """
    try:
        # Decode without verification (verify signature in production!)
        # For production, fetch Apple's public keys and verify signature
        payload = jwt.decode(
            id_token,
            options={"verify_signature": False},  # TODO: Verify in production
        )

        return {
            "id": payload.get("sub"),
            "email": payload.get("email"),
            "email_verified": payload.get("email_verified", False),
            "is_private_email": payload.get("is_private_email", False),
        }
    except JWTError as e:
        raise JWTError(f"Failed to decode Apple ID token: {str(e)}")


def _generate_apple_client_secret() -> str:
    """Generate Apple client secret JWT.

    Apple requires a JWT signed with your private key as the client secret.

    Returns:
        Signed JWT to use as client_secret

    Note:
        Requires APPLE_TEAM_ID, APPLE_KEY_ID, and APPLE_PRIVATE_KEY to be configured.
    """
    now = datetime.utcnow()
    expiration = now + timedelta(days=180)  # Max 6 months

    claims = {
        "iss": oauth_config.apple_team_id,
        "iat": int(now.timestamp()),
        "exp": int(expiration.timestamp()),
        "aud": "https://appleid.apple.com",
        "sub": oauth_config.apple_client_id,
    }

    headers = {
        "kid": oauth_config.apple_key_id,
        "alg": "ES256",
    }

    # Sign with private key
    client_secret = jwt.encode(
        claims,
        oauth_config.apple_private_key,
        algorithm="ES256",
        headers=headers,
    )

    return client_secret

