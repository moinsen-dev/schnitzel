        "response_type": "code",
        "scope": "openid email profile",
        "state": state,
        "access_type": "offline",
        "prompt": "consent",
    }

    base_url = "https://accounts.google.com/o/oauth2/v2/auth"
    return f"{base_url}?{urlencode(params)}"


async def google_callback(code: str) -> Dict[str, Any]:
    """Exchange authorization code for access token and fetch user info.

    Creates or retrieves user account and returns JWT tokens.

    Args:
        code: Authorization code from Google OAuth callback

    Returns:
        Dictionary containing user info and JWT tokens

    Raises:
        httpx.HTTPError: If token exchange or user info request fails

    Example:
        >>> result = await google_callback(code="auth-code-123")
        >>> print(result["user"]["email"])
        >>> access_token = result["access_token"]
    """
    # Exchange code for tokens
    token_url = "https://oauth2.googleapis.com/token"
    token_data = {
        "code": code,
        "client_id": oauth_config.google_client_id,
        "client_secret": oauth_config.google_client_secret,
        "redirect_uri": oauth_config.google_redirect_uri,
        "grant_type": "authorization_code",
    }

    async with httpx.AsyncClient() as client:
        # Get tokens
        token_response = await client.post(token_url, data=token_data)
        token_response.raise_for_status()
        tokens = token_response.json()

        # Get user info
        user_info = await get_google_user_info(tokens["access_token"])

        # Create or get user and generate JWT tokens
        result = get_or_create_user(
            provider="google",
            email=user_info["email"],
            provider_id=user_info["id"]
        )

        return result


async def get_google_user_info(access_token: str) -> Dict[str, Any]:
    """Fetch user information from Google using access token.

    Args:
        access_token: Google OAuth access token

    Returns:
        Dictionary with user info (id, email, name, picture, etc.)

    Raises:
        httpx.HTTPError: If user info request fails

    Example:
        >>> user_info = await get_google_user_info(access_token)
        >>> print(f"User: {user_info['name']} ({user_info['email']})")
    """
    userinfo_url = "https://www.googleapis.com/oauth2/v2/userinfo"
    headers = {"Authorization": f"Bearer {access_token}"}

    async with httpx.AsyncClient() as client:
        response = await client.get(userinfo_url, headers=headers)
        response.raise_for_status()
        return response.json()

