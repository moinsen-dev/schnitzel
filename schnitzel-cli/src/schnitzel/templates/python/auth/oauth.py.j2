def validate_oauth_state(provided_state: str, stored_state: str) -> bool:
    """Validate OAuth state parameter for CSRF protection (simple constant-time comparison).

    This is a basic validation for session-based state storage.
    For production with Redis, use generate_oauth_state() and validate_oauth_state_redis().

    Args:
        provided_state: State parameter from OAuth callback
        stored_state: State parameter stored before redirect

    Returns:
        True if states match, False otherwise

    Example:
        >>> state = secrets.token_urlsafe(32)
        >>> # Store state in session/redis
        >>> # After callback:
        >>> if validate_oauth_state(callback_state, stored_state):
        ...     # Proceed with authentication
        ...     pass
    """
    return secrets.compare_digest(provided_state, stored_state)


