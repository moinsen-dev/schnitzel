async def apple_callback(code: str, id_token: Optional[str] = None) -> Dict[str, Any]:
    """Exchange authorization code for tokens and extract user info.

    Apple Sign In returns an id_token which contains user information.
    Creates or retrieves user account and returns JWT tokens.

    Args:
