def get_github_auth_url(state: Optional[str] = None) -> str:
    """Generate GitHub OAuth authorization URL.

    Args:
        state: Optional state parameter for CSRF protection. If None, generates random state.

    Returns:
        Authorization URL string

    Example:
        >>> auth_url = get_github_auth_url(state="random-state-123")
        >>> # Redirect user to auth_url
    """
    if state is None:
        state = secrets.token_urlsafe(32)

    params = {
        "client_id": oauth_config.github_client_id,
        "redirect_uri": oauth_config.github_redirect_uri,
        "scope": "user:email",
        "state": state,
    }

    base_url = "https://github.com/login/oauth/authorize"
    return f"{base_url}?{urlencode(params)}"


async def github_callback(code: str) -> Dict[str, Any]:
    """Exchange authorization code for access token and fetch user info.

    Creates or retrieves user account and returns JWT tokens.

    Args:
        code: Authorization code from GitHub OAuth callback

    Returns:
        Dictionary containing user info and JWT tokens

    Raises:
        httpx.HTTPError: If token exchange or user info request fails

    Example:
        >>> result = await github_callback(code="auth-code-123")
        >>> print(result["user"]["email"])
        >>> access_token = result["access_token"]
    """
    # Exchange code for tokens
    token_url = "https://github.com/login/oauth/access_token"
    token_data = {
        "code": code,
        "client_id": oauth_config.github_client_id,
        "client_secret": oauth_config.github_client_secret,
        "redirect_uri": oauth_config.github_redirect_uri,
    }

    async with httpx.AsyncClient() as client:
        # Get tokens (GitHub returns form-encoded response by default, request JSON)
        token_response = await client.post(
            token_url,
            data=token_data,
            headers={"Accept": "application/json"}
        )
        token_response.raise_for_status()
        tokens = token_response.json()

        # Get user info from GitHub API
        user_info = await get_github_user_info(tokens["access_token"])

        # Create or get user and generate JWT tokens
        result = get_or_create_user(
            provider="github",
            email=user_info["email"],
            provider_id=user_info["id"]
        )

        return result


async def get_github_user_info(access_token: str) -> Dict[str, Any]:
    """Fetch user information from GitHub API using access token.

    Args:
        access_token: GitHub OAuth access token

    Returns:
        Dictionary with user info (id, email, login, name, etc.)

    Raises:
        httpx.HTTPError: If user info request fails

    Example:
        >>> user_info = await get_github_user_info(access_token)
        >>> print(f"User: {user_info['name']} (@{user_info['login']})")
    """
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "application/vnd.github.v3+json"
    }

    async with httpx.AsyncClient() as client:
        # Get user profile
        user_response = await client.get("https://api.github.com/user", headers=headers)
        user_response.raise_for_status()
        user_data = user_response.json()

        # Get user emails (GitHub user endpoint may not include email)
        email = user_data.get("email")
        if not email:
            emails_response = await client.get("https://api.github.com/user/emails", headers=headers)
            emails_response.raise_for_status()
            emails = emails_response.json()

            # Find primary verified email
            for email_obj in emails:
                if email_obj.get("primary") and email_obj.get("verified"):
                    email = email_obj.get("email")
                    break

            # Fallback to first verified email
            if not email:
                for email_obj in emails:
                    if email_obj.get("verified"):
                        email = email_obj.get("email")
                        break

        return {
            "id": str(user_data.get("id")),
            "email": email,
            "login": user_data.get("login"),
            "name": user_data.get("name"),
            "avatar_url": user_data.get("avatar_url"),
            "bio": user_data.get("bio"),
        }

