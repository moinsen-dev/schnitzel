{% if oauth_config.has_magic_link %}
@auth_router.post("/magic-link")
async def send_magic_link_endpoint(request: MagicLinkRequest):
    """Send a magic link to the user's email for passwordless authentication.

    Args:
        request: Magic link request with email

    Returns:
        Success message

    Raises:
        HTTPException: 500 if email sending fails

    Example:
        POST /auth/magic-link
        {
            "email": "user@example.com"
        }
    """
    # Generate magic link
    token, magic_link = generate_magic_link(request.email)

    # Send email
    await send_magic_link_email(request.email, magic_link)

    return {
        "message": "Magic link sent to your email",
        "email": request.email
    }


@auth_router.get("/magic-link/verify", response_model=TokenResponse)
async def verify_magic_link_endpoint(token: str) -> TokenResponse:
    """Verify a magic link token and authenticate the user.

    Args:
        token: Magic link token from email

    Returns:
        TokenResponse with access_token and refresh_token

    Raises:
        HTTPException: 401 if token is invalid or expired

    Example:
        GET /auth/magic-link/verify?token=...
    """
    try:
        # Verify token and get email
        email = verify_magic_link(token)

        # Get or create user
        user = _get_user_by_email(email)
        if not user:
            # Create new user with magic link authentication
            user = _create_user(email=email, provider="magic_link")

        # Generate JWT tokens
        tokens = create_tokens(user["id"], user["email"])

        return TokenResponse(
            access_token=tokens["access_token"],
            refresh_token=tokens["refresh_token"]
        )

    except (JWTError, ValueError) as e:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail=f"Invalid or expired magic link: {str(e)}"
        )

{% endif %}
