def generate_magic_link(email: str) -> tuple[str, str]:
    """Generate a magic link token for passwordless authentication.

    Creates a signed JWT token containing the user's email and expiration time.

    Args:
        email: User's email address

    Returns:
        Tuple of (token, magic_link_url)

    Example:
        >>> token, link = generate_magic_link("user@example.com")
        >>> # Send link via email to user
        >>> print(f"Magic link: {link}")
    """
    # Generate token with email and expiration
    expiration = datetime.utcnow() + timedelta(
        minutes=oauth_config.magic_link_expiry_minutes
    )

    payload = {
        "email": email,
        "exp": expiration,
        "type": "magic_link",
    }

    token = jwt.encode(
        payload,
        oauth_config.magic_link_secret,
        algorithm="HS256",
    )

    # Build magic link URL
    base_url = "{{ oauth_config.callback_url }}/magic-link/verify"
    magic_link_url = f"{base_url}?token={token}"

    return token, magic_link_url


def verify_magic_link(token: str) -> str:
    """Verify a magic link token and extract the email.

    Args:
        token: Magic link token to verify

    Returns:
        Email address from the token

    Raises:
        JWTError: If token is invalid or expired
        ValueError: If token type is not magic_link

    Example:
        >>> try:
        ...     email = verify_magic_link(token)
        ...     # Authenticate user with this email
        ... except JWTError:
        ...     # Token invalid or expired
        ...     pass
    """
    try:
        payload = jwt.decode(
            token,
            oauth_config.magic_link_secret,
            algorithms=["HS256"],
        )

        # Verify token type
        if payload.get("type") != "magic_link":
            raise ValueError("Invalid token type")

        email = payload.get("email")
        if not email:
            raise ValueError("Email not found in token")

        return email

    except JWTError as e:
        raise JWTError(f"Magic link verification failed: {str(e)}")


async def send_magic_link_email(email: str, magic_link: str) -> bool:
    """Send magic link email to user via SMTP.

    Uses SMTP configuration from environment variables to send the magic link email.
    Falls back to console output if SMTP is not configured.

    Args:
        email: Recipient email address
        magic_link: Magic link URL to include in email

    Returns:
        True if email was sent successfully, False otherwise

    Raises:
        Exception: If SMTP sending fails

    Example:
        >>> token, link = generate_magic_link("user@example.com")
        >>> success = await send_magic_link_email("user@example.com", link)
        >>> if success:
        ...     print("Magic link sent!")
    """
    # Check if SMTP is configured
    if not oauth_config.smtp_host or not oauth_config.smtp_user:
        # Fallback: Print to console (for development)
        print(f"[DEV MODE] Magic link email for {email}")
        print(f"[DEV MODE] Magic link: {magic_link}")
        print("[DEV MODE] Configure SMTP_HOST, SMTP_USER, SMTP_PASSWORD to send real emails")
        return True

    try:
        # Create email message
        msg = MIMEMultipart('alternative')
        msg['Subject'] = 'Your Magic Link - Sign In'
        msg['From'] = oauth_config.smtp_from_email
        msg['To'] = email

        # Plain text version
        text = f"""
Hello,

Click the link below to sign in to your account:

{magic_link}

This link will expire in {oauth_config.magic_link_expiry_minutes} minutes.

If you didn't request this link, you can safely ignore this email.
"""

        # HTML version
        html = f"""
<html>
  <head></head>
  <body>
    <h2>Sign In to Your Account</h2>
    <p>Click the button below to sign in:</p>
    <p>
      <a href="{magic_link}"
         style="display: inline-block; padding: 12px 24px; background-color: #007bff;
                color: white; text-decoration: none; border-radius: 4px;">
        Sign In
      </a>
    </p>
    <p>Or copy and paste this link into your browser:</p>
    <p><a href="{magic_link}">{magic_link}</a></p>
    <p style="color: #666; font-size: 14px;">
      This link will expire in {oauth_config.magic_link_expiry_minutes} minutes.
    </p>
    <p style="color: #999; font-size: 12px;">
      If you didn't request this link, you can safely ignore this email.
    </p>
  </body>
</html>
"""

        # Attach both versions
        part1 = MIMEText(text, 'plain')
        part2 = MIMEText(html, 'html')
        msg.attach(part1)
        msg.attach(part2)

        # Connect to SMTP server and send
        with smtplib.SMTP(oauth_config.smtp_host, oauth_config.smtp_port) as server:
            server.starttls()  # Enable TLS
            server.login(oauth_config.smtp_user, oauth_config.smtp_password)
            server.send_message(msg)

        return True

    except Exception as e:
        print(f"[ERROR] Failed to send magic link email: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Failed to send magic link email"
