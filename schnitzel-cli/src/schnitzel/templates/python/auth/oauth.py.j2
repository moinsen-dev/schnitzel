def create_tokens(user_id: str, email: str) -> Dict[str, str]:
    """Create access and refresh tokens for a user.

    Args:
        user_id: Unique user identifier
        email: User's email address

    Returns:
        Dictionary with access_token and refresh_token

    Example:
        >>> tokens = create_tokens("user-123", "user@example.com")
        >>> access = tokens["access_token"]
        >>> refresh = tokens["refresh_token"]
    """
    # Create access token
    access_expiration = datetime.utcnow() + timedelta(
        minutes=oauth_config.jwt_access_token_expire_minutes
    )
    access_payload = {
        "sub": user_id,
        "email": email,
        "exp": access_expiration,
        "type": "access",
    }
    access_token = jwt.encode(
        access_payload,
        oauth_config.jwt_secret_key,
        algorithm=oauth_config.jwt_algorithm,
    )

    # Create refresh token
    refresh_expiration = datetime.utcnow() + timedelta(
        days=oauth_config.jwt_refresh_token_expire_days
    )
    refresh_payload = {
        "sub": user_id,
        "email": email,
        "exp": refresh_expiration,
        "type": "refresh",
    }
    refresh_token = jwt.encode(
        refresh_payload,
        oauth_config.jwt_secret_key,
        algorithm=oauth_config.jwt_algorithm,
    )

    return {
        "access_token": access_token,
        "refresh_token": refresh_token,
    }


