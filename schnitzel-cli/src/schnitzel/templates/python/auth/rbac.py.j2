from typing import List, Set, Optional
from dataclasses import dataclass, field
from fastapi import Depends, HTTPException, status
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials


# =============================================================================
# Role Definition
# =============================================================================

@dataclass
class Role:
    """Role definition with permissions and inheritance."""

    name: str
    permissions: List[str] = field(default_factory=list)
    inherits: List[str] = field(default_factory=list)
    description: str = ""

    def __post_init__(self):
        """Initialize role after dataclass creation."""
        # Ensure permissions and inherits are lists
        if not isinstance(self.permissions, list):
            self.permissions = list(self.permissions) if self.permissions else []
        if not isinstance(self.inherits, list):
            self.inherits = list(self.inherits) if self.inherits else []


# =============================================================================
# Role Registry
# =============================================================================

class RoleRegistry:
    """Registry for managing role definitions and permission checking."""

    def __init__(self):
        """Initialize the role registry."""
        self._roles: dict[str, Role] = {}
        self._permission_cache: dict[str, Set[str]] = {}
        self._user_permissions: dict[str, Set[str]] = {}  # user_id -> set of permissions

    def register_role(self, role: Role) -> None:
        """
        Register a role in the registry.

        Args:
            role: Role instance to register

        Example:
            >>> registry = RoleRegistry()
            >>> registry.register_role(Role(name="admin", permissions=["*"]))
        """
        self._roles[role.name] = role
        # Clear cache when roles change
        self._permission_cache.clear()

    def get_role(self, role_name: str) -> Optional[Role]:
        """
        Get a role by name.

        Args:
            role_name: Name of the role to retrieve

        Returns:
            Role instance or None if not found

        Example:
            >>> role = registry.get_role("admin")
        """
        return self._roles.get(role_name)

    def get_all_permissions(self, role_name: str, _visited: Optional[Set[str]] = None) -> Set[str]:
        """
        Get all permissions for a role including inherited permissions.

        Uses caching to avoid repeated inheritance resolution.
        Detects and prevents circular inheritance chains.

        Args:
            role_name: Name of the role
            _visited: Internal parameter for circular inheritance detection

        Returns:
            Set of all permissions (direct + inherited)

        Raises:
            ValueError: If circular inheritance is detected

        Example:
            >>> permissions = registry.get_all_permissions("moderator")
            >>> "users:read" in permissions
            True
        """
        # Check cache first (only if not in recursion)
        if _visited is None and role_name in self._permission_cache:
            return self._permission_cache[role_name]

        # Initialize visited set for circular detection
        if _visited is None:
            _visited = set()

        # Check for circular inheritance
        if role_name in _visited:
            raise ValueError(
                f"Circular inheritance detected: {role_name} is already in inheritance chain"
            )

        # Mark this role as visited
        _visited.add(role_name)

        # Get role
        role = self.get_role(role_name)
        if not role:
            return set()

        # Start with direct permissions
        all_permissions = set(role.permissions)

        # Recursively add inherited permissions
        for parent_role_name in role.inherits:
            parent_permissions = self.get_all_permissions(parent_role_name, _visited.copy())
            all_permissions.update(parent_permissions)

        # Cache and return (only at top level)
        if len(_visited) == 1:
            self._permission_cache[role_name] = all_permissions

        return all_permissions

    def add_permission_to_role(self, role_name: str, permission: str) -> bool:
        """
        Dynamically add a permission to a role at runtime.

        This allows for runtime modification of role permissions. Changes take
        effect immediately and are reflected in all permission checks.

        Args:
            role_name: Name of the role to modify
            permission: Permission string to add (e.g., "users:write")

        Returns:
            True if permission was added, False if role doesn't exist

        Example:
            >>> registry.add_permission_to_role("moderator", "posts:delete")
            True
            >>> # Permission is now available immediately
            >>> has_permission(["moderator"], "posts:delete")
            True
        """
        role = self.get_role(role_name)
        if not role:
            return False

        # Add permission if not already present
        if permission not in role.permissions:
            role.permissions.append(permission)
            # Clear cache to ensure changes take effect immediately
            self._permission_cache.clear()

        return True

    def remove_permission_from_role(self, role_name: str, permission: str) -> bool:
        """
        Dynamically remove a permission from a role at runtime.

        This allows for runtime modification of role permissions. Changes take
        effect immediately and are reflected in all permission checks.

        Args:
            role_name: Name of the role to modify
            permission: Permission string to remove (e.g., "users:write")

        Returns:
            True if permission was removed, False if role doesn't exist or permission not found

        Example:
            >>> registry.remove_permission_from_role("moderator", "posts:delete")
            True
            >>> # Permission is now unavailable immediately
            >>> has_permission(["moderator"], "posts:delete")
            False
        """
        role = self.get_role(role_name)
        if not role:
            return False

        # Remove permission if present
        if permission in role.permissions:
            role.permissions.remove(permission)
            # Clear cache to ensure changes take effect immediately
            self._permission_cache.clear()
            return True

        return False

    def grant_permission_to_user(self, user_id: str, permission: str) -> None:
        """
        Grant a permission directly to a user, beyond their role permissions.

        This allows users to have additional permissions that are not part of their
        assigned roles. User-specific permissions take precedence and are checked
        alongside role-based permissions.

        Args:
            user_id: Unique identifier for the user
            permission: Permission string to grant (e.g., "admin:override")

        Example:
            >>> registry.grant_permission_to_user("user-123", "reports:view_sensitive")
            >>> # User now has this permission regardless of their role
            >>> has_permission(user_id="user-123", user_roles=["user"], permission="reports:view_sensitive")
            True
        """
        if user_id not in self._user_permissions:
            self._user_permissions[user_id] = set()
        self._user_permissions[user_id].add(permission)

    def revoke_permission_from_user(self, user_id: str, permission: str) -> bool:
        """
        Revoke a user-specific permission.

        Removes a permission that was granted directly to the user. Does not affect
        permissions granted through roles.

        Args:
            user_id: Unique identifier for the user
            permission: Permission string to revoke

        Returns:
            True if permission was revoked, False if user had no such permission

        Example:
            >>> registry.revoke_permission_from_user("user-123", "reports:view_sensitive")
            True
        """
        if user_id in self._user_permissions and permission in self._user_permissions[user_id]:
            self._user_permissions[user_id].discard(permission)
            # Clean up empty sets
            if not self._user_permissions[user_id]:
                del self._user_permissions[user_id]
            return True
        return False

    def get_user_specific_permissions(self, user_id: str) -> Set[str]:
        """
        Get all permissions granted directly to a user (not through roles).

        Args:
            user_id: Unique identifier for the user

        Returns:
            Set of user-specific permission strings

        Example:
            >>> perms = registry.get_user_specific_permissions("user-123")
            >>> "reports:view_sensitive" in perms
            True
        """
        return self._user_permissions.get(user_id, set()).copy()

    def check_permission(self, user_roles: List[str], permission: str, user_id: Optional[str] = None) -> bool:
        """
        Check if any of the user's roles grants a specific permission.

        Supports:
        - Wildcard permissions: "*" grants all permissions
        - Scoped permissions: "resource:action:scope" format
        - Partial wildcards: "users:*", "users:read:*"
        - User-specific permissions: Checks permissions granted directly to the user

        Args:
            user_roles: List of role names assigned to the user
            permission: Permission string to check (e.g., "users:read:own")
            user_id: Optional user ID to check user-specific permissions (auth_108)

        Returns:
            True if user has the permission, False otherwise

        Example:
            >>> registry.check_permission(["admin"], "users:delete")
            True
            >>> registry.check_permission(["user"], "users:delete")
            False
            >>> # With user-specific permissions
            >>> registry.check_permission(["user"], "reports:view", user_id="user-123")
            True  # if user-123 has been granted this permission directly
        """
        # Check user-specific permissions first (auth_108)
        if user_id and user_id in self._user_permissions:
            user_specific_perms = self._user_permissions[user_id]
            # Check for global wildcard
            if "*" in user_specific_perms:
                return True
            # Check for exact match
            if permission in user_specific_perms:
                return True
            # Check for wildcard matches in user-specific permissions
            if self._check_wildcard_permission(permission, user_specific_perms):
                return True

        if not user_roles:
            return False

        # Get all permissions from all user roles
        user_permissions = set()
        for role_name in user_roles:
            role_permissions = self.get_all_permissions(role_name)
            user_permissions.update(role_permissions)

        # Check for global wildcard
        if "*" in user_permissions:
            return True

        # Check for exact match
        if permission in user_permissions:
            return True

        # Check for wildcard matches
        if self._check_wildcard_permission(permission, user_permissions):
            return True

        return False

    def _check_wildcard_permission(self, permission: str, permission_set: Set[str]) -> bool:
        """
        Check if a permission matches any wildcard patterns in a permission set.

        Args:
            permission: Permission to check (e.g., "users:read:own")
            permission_set: Set of permissions that may contain wildcards

        Returns:
            True if permission matches any wildcard pattern, False otherwise
        """
        # Split permission into parts (e.g., "users:read:own" -> ["users", "read", "own"])
        permission_parts = permission.split(":")

        for user_perm in permission_set:
            if "*" in user_perm:
                # Check if wildcard permission matches
                user_perm_parts = user_perm.split(":")

                # Compare each part
                matches = True
                for i, user_part in enumerate(user_perm_parts):
                    if user_part == "*":
                        # Wildcard matches everything at this level and beyond
                        break
                    if i >= len(permission_parts) or user_part != permission_parts[i]:
                        matches = False
                        break

                if matches:
                    return True

        return False


