# Session Store
# =============================================================================

class SessionStore:
    """Redis-based session store with TTL and sliding expiration support.

    Features:
    - Unique session ID generation using secrets.token_urlsafe
    - Session data stored as JSON in Redis
    - Automatic expiry using Redis TTL
    - Sliding expiration: reset TTL on each access
    - Session key format: "session:{session_id}"
    """

    def __init__(
        self,
        redis_client: Optional[Redis] = None,
        redis_host: str = "localhost",
        redis_port: int = 6379,
        redis_db: int = 0,
        redis_password: Optional[str] = None,
    ):
        """Initialize session store with Redis connection.

        Args:
            redis_client: Pre-configured Redis client (optional)
            redis_host: Redis server host (default: localhost)
            redis_port: Redis server port (default: 6379)
            redis_db: Redis database number (default: 0)
            redis_password: Redis password (optional)

        Example:
            >>> store = SessionStore()
            >>> session_id = store.create_session("user-123", {"email": "user@example.com"})
        """
        if redis_client:
            self.redis = redis_client
        else:
            self.redis = Redis(
                host=redis_host,
                port=redis_port,
                db=redis_db,
                password=redis_password,
                decode_responses=True,
            )

    def _get_session_key(self, session_id: str) -> str:
        """Generate Redis key for session.

        Args:
            session_id: Unique session identifier

        Returns:
            Redis key in format "session:{session_id}"
        """
        return f"session:{session_id}"

    def create_session(
        self,
        user_id: str,
        data: Optional[Dict[str, Any]] = None,
        remember_me: bool = False,
        device_name: Optional[str] = None,
        ip_address: Optional[str] = None,
        user_agent: Optional[str] = None,
    ) -> str:
        """Create a new session with unique session ID.

        Generates a secure random session ID using secrets.token_urlsafe,
        stores user data as JSON in Redis, and sets TTL for automatic expiry.

        {% if session_config.multi_device %}
        Multi-device support is enabled. Device metadata (device_name, ip_address, user_agent)
        will be stored with the session. The session is also tracked in a user-specific index
        for listing all active sessions per user.
        {% endif %}

        {% if session_config.remember_me_duration %}
        Remember me functionality is enabled. When remember_me=True, the session will use
        an extended TTL of {{ session_config.remember_me_duration }} seconds instead of the
        default {{ session_config.expiry }} seconds. This allows for persistent login across
        browser sessions via secure cookies.
        {% endif %}

        Args:
            user_id: User identifier to associate with session
            data: Optional additional session data to store
            remember_me: If True, use extended remember_me_duration for TTL
            device_name: Optional device name for multi-device tracking (e.g., "iPhone 12")
            ip_address: Optional IP address for security auditing
            user_agent: Optional User-Agent string for device identification

        Returns:
            Unique session ID

        Raises:
            RedisError: If Redis operation fails

        Example:
            >>> session_id = store.create_session(
            ...     "user-123",
            ...     {"email": "user@example.com", "role": "admin"},
            ...     remember_me=True,
            ...     device_name="Chrome on MacBook",
            ...     ip_address="192.168.1.100",
            ...     user_agent="Mozilla/5.0..."
            ... )
        """
        # Generate unique session ID (32 bytes = 43 characters base64url)
        session_id = secrets.token_urlsafe(32)

        # Build session data
        session_data = {
            "user_id": user_id,
            "created_at": datetime.utcnow().isoformat(),
            "last_accessed": datetime.utcnow().isoformat(),
        }

        # Add device metadata for multi-device support
        {% if session_config.multi_device %}
        if device_name:
            session_data["device_name"] = device_name
        if ip_address:
            session_data["ip_address"] = ip_address
        if user_agent:
            session_data["user_agent"] = user_agent
        {% endif %}

        # Merge additional data
        if data:
            session_data.update(data)

        # Determine TTL
        if remember_me and session_config.remember_me_duration:
            ttl = session_config.remember_me_duration
            session_data["remember_me"] = True
        else:
            ttl = session_config.expiry
            session_data["remember_me"] = False

        # Store in Redis with TTL
        key = self._get_session_key(session_id)
        try:
            self.redis.setex(key, ttl, json.dumps(session_data))

            {% if session_config.multi_device %}
            # Track session in user-specific index for multi-device support
            user_sessions_key = f"user_sessions:{user_id}"
            self.redis.sadd(user_sessions_key, session_id)
            # Set expiry on the user sessions index (slightly longer than max session TTL)
            max_ttl = session_config.remember_me_duration or session_config.expiry
            self.redis.expire(user_sessions_key, max_ttl + 3600)
            {% endif %}
        except RedisError as e:
            raise RedisError(f"Failed to create session: {e}")

        return session_id

    def get_session(self, session_id: str) -> Optional[Dict[str, Any]]:
        """Retrieve session data by session ID.

        If sliding_window is enabled, automatically refreshes the session TTL
        to extend the session lifetime.

        Args:
            session_id: Session identifier

        Returns:
            Session data as dictionary, or None if session not found or expired

        Example:
            >>> data = store.get_session("abc123...")
            >>> if data:
            ...     print(f"User ID: {data['user_id']}")
        """
        key = self._get_session_key(session_id)

        try:
            session_json = self.redis.get(key)
            if not session_json:
                return None

            # Parse session data
            session_data = json.loads(session_json)

            # Update last accessed timestamp
            session_data["last_accessed"] = datetime.utcnow().isoformat()

            # Refresh session TTL if sliding window is enabled
            if session_config.sliding_window:
                self.refresh_session(session_id)
            else:
                # Still update the last_accessed timestamp even without sliding window
                ttl = self.redis.ttl(key)
                if ttl > 0:
                    self.redis.setex(key, ttl, json.dumps(session_data))

            return session_data

        except (RedisError, json.JSONDecodeError):
            return None

    def update_session(self, session_id: str, data: Dict[str, Any]) -> bool:
        """Update session data.

        Merges new data with existing session data while preserving TTL.

        Args:
            session_id: Session identifier
            data: Data to merge into session

        Returns:
            True if session was updated, False if session not found

        Example:
            >>> updated = store.update_session(
            ...     "abc123...",
            ...     {"last_page": "/dashboard"}
            ... )
        """
        key = self._get_session_key(session_id)

        try:
            # Get current session data
            session_json = self.redis.get(key)
            if not session_json:
                return False

            # Get current TTL
            ttl = self.redis.ttl(key)
            if ttl <= 0:
                return False

            # Parse and merge data
            session_data = json.loads(session_json)
            session_data.update(data)
            session_data["last_accessed"] = datetime.utcnow().isoformat()

            # Write back with same TTL
            self.redis.setex(key, ttl, json.dumps(session_data))
            return True

        except (RedisError, json.JSONDecodeError):
            return False

    def delete_session(self, session_id: str) -> bool:
        """Delete a session.

        {% if session_config.multi_device %}
        When multi-device support is enabled, this also removes the session from
        the user's session index.
        {% endif %}

        Args:
            session_id: Session identifier

        Returns:
            True if session was deleted, False if session not found

        Example:
            >>> store.delete_session("abc123...")
        """
        key = self._get_session_key(session_id)

        try:
            {% if session_config.multi_device %}
            # Get user_id before deleting to clean up index
            session_json = self.redis.get(key)
            if session_json:
                session_data = json.loads(session_json)
                user_id = session_data.get("user_id")
                if user_id:
                    user_sessions_key = f"user_sessions:{user_id}"
                    self.redis.srem(user_sessions_key, session_id)
            {% endif %}

            result = self.redis.delete(key)
            return result > 0
        except RedisError:
            return False

    def refresh_session(self, session_id: str) -> bool:
        """Refresh session TTL for sliding expiration.

        Resets the TTL to the configured expiry duration, effectively
        extending the session lifetime on each access.

        Args:
            session_id: Session identifier

        Returns:
            True if session TTL was refreshed, False if session not found

        Example:
            >>> store.refresh_session("abc123...")
        """
        key = self._get_session_key(session_id)

        try:
            # Check if session exists
            if not self.redis.exists(key):
                return False

            # Reset TTL to full expiry duration
            self.redis.expire(key, session_config.expiry)
            return True

        except RedisError:
            return False

    def get_user_sessions(self, user_id: str) -> list[str]:
        """Get all active session IDs for a user.

        {% if session_config.multi_device %}
        Uses the user-specific session index "user_sessions:{user_id}" for efficient lookup.
        Returns only sessions that still exist (filters out expired sessions from the index).
        {% else %}
        Multi-device support is disabled, this will return an empty list.
        {% endif %}

        Args:
            user_id: User identifier

        Returns:
            List of active session IDs for the user

        Example:
            >>> sessions = store.get_user_sessions("user-123")
            >>> print(f"User has {len(sessions)} active sessions")
            >>> for session_id in sessions:
            ...     session_data = store.get_session(session_id)
            ...     print(f"Device: {session_data.get('device_name')}")
            ...     print(f"IP: {session_data.get('ip_address')}")
        """
        if not session_config.multi_device:
            return []

        try:
            {% if session_config.multi_device %}
            # Use user-specific index for efficient lookup
            user_sessions_key = f"user_sessions:{user_id}"
            session_ids = self.redis.smembers(user_sessions_key)

            # Filter out expired sessions (not in Redis anymore)
            active_sessions = []
            for session_id in session_ids:
                key = self._get_session_key(session_id)
                if self.redis.exists(key):
                    active_sessions.append(session_id)
                else:
                    # Clean up expired session from index
                    self.redis.srem(user_sessions_key, session_id)

            return active_sessions
            {% else %}
            return []
            {% endif %}

        except RedisError:
            return []

    def delete_user_sessions(self, user_id: str) -> int:
        """Delete all sessions for a user.

        Useful for logout from all devices or account security actions.

        Args:
            user_id: User identifier

        Returns:
            Number of sessions deleted

        Example:
            >>> deleted = store.delete_user_sessions("user-123")
            >>> print(f"Deleted {deleted} sessions")
        """
        session_ids = self.get_user_sessions(user_id)
        deleted_count = 0

        for session_id in session_ids:
            if self.delete_session(session_id):
                deleted_count += 1

        return deleted_count


