# =============================================================================
# In-Memory Session Store (Development/Testing Only)
# =============================================================================

class MemorySessionStore:
    """In-memory session store for development and testing.

    WARNING: This is NOT suitable for production use. Sessions are stored in memory
    and will be lost when the application restarts. Use Redis or Database storage
    for production deployments.

    Features:
    - Simple dict-based storage
    - Simulates TTL with timestamp checking
    - Thread-safe with manual locking (consider using threading.Lock for production-like testing)
    - No persistence across restarts

    Example:
        >>> store = MemorySessionStore()
        >>> session_id = store.create_session("user-123", {"email": "user@example.com"})
        >>> session_data = store.get_session(session_id)
    """

    def __init__(self):
        """Initialize in-memory session store."""
        self._sessions: Dict[str, Dict[str, Any]] = {}
        {% if session_config.multi_device %}
        self._user_sessions: Dict[str, set] = {}  # user_id -> set of session_ids
        {% endif %}

    def create_session(
        self,
        user_id: str,
        data: Optional[Dict[str, Any]] = None,
        remember_me: bool = False,
        device_name: Optional[str] = None,
        ip_address: Optional[str] = None,
        user_agent: Optional[str] = None,
    ) -> str:
        """Create a new session in memory.

        Args:
            user_id: User identifier
            data: Optional additional session data
            remember_me: If True, use extended TTL
            device_name: Optional device name
            ip_address: Optional IP address
            user_agent: Optional User-Agent string

        Returns:
            Unique session ID
        """
        session_id = secrets.token_urlsafe(32)

        session_data = {
            "user_id": user_id,
            "created_at": datetime.utcnow().isoformat(),
            "last_accessed": datetime.utcnow().isoformat(),
        }

        {% if session_config.multi_device %}
        if device_name:
            session_data["device_name"] = device_name
        if ip_address:
            session_data["ip_address"] = ip_address
        if user_agent:
            session_data["user_agent"] = user_agent
        {% endif %}

        if data:
            session_data.update(data)

        if remember_me and session_config.remember_me_duration:
            ttl = session_config.remember_me_duration
            session_data["remember_me"] = True
        else:
            ttl = session_config.expiry
            session_data["remember_me"] = False

        # Store expiry timestamp
        expires_at = datetime.utcnow() + timedelta(seconds=ttl)
        session_data["_expires_at"] = expires_at.isoformat()

        self._sessions[session_id] = session_data

        {% if session_config.multi_device %}
        # Track in user sessions index
        if user_id not in self._user_sessions:
            self._user_sessions[user_id] = set()
        self._user_sessions[user_id].add(session_id)
        {% endif %}

        return session_id

    def get_session(self, session_id: str) -> Optional[Dict[str, Any]]:
        """Retrieve session from memory.

        Args:
            session_id: Session identifier

        Returns:
            Session data or None if not found/expired
        """
        session_data = self._sessions.get(session_id)
        if not session_data:
            return None

        # Check expiry
        expires_at = datetime.fromisoformat(session_data["_expires_at"])
        if datetime.utcnow() > expires_at:
            # Session expired, remove it
            self.delete_session(session_id)
            return None

        # Update last accessed
        session_data["last_accessed"] = datetime.utcnow().isoformat()

        # Refresh expiry if sliding window enabled
        {% if session_config.sliding_window %}
        new_expires_at = datetime.utcnow() + timedelta(seconds=session_config.expiry)
        session_data["_expires_at"] = new_expires_at.isoformat()
        {% endif %}

        # Return copy without internal fields
        result = {k: v for k, v in session_data.items() if not k.startswith("_")}
        return result

    def update_session(self, session_id: str, data: Dict[str, Any]) -> bool:
        """Update session data in memory.

        Args:
            session_id: Session identifier
            data: Data to merge into session

        Returns:
            True if updated, False if not found
        """
        session_data = self._sessions.get(session_id)
        if not session_data:
            return False

        # Check expiry
        expires_at = datetime.fromisoformat(session_data["_expires_at"])
        if datetime.utcnow() > expires_at:
            self.delete_session(session_id)
            return False

        session_data.update(data)
        session_data["last_accessed"] = datetime.utcnow().isoformat()
        return True

    def delete_session(self, session_id: str) -> bool:
        """Delete session from memory.

        Args:
            session_id: Session identifier

        Returns:
            True if deleted, False if not found
        """
        session_data = self._sessions.pop(session_id, None)
        if not session_data:
            return False

        {% if session_config.multi_device %}
        # Remove from user sessions index
        user_id = session_data.get("user_id")
        if user_id and user_id in self._user_sessions:
            self._user_sessions[user_id].discard(session_id)
            if not self._user_sessions[user_id]:
                del self._user_sessions[user_id]
        {% endif %}

        return True

    def refresh_session(self, session_id: str) -> bool:
        """Refresh session expiry in memory.

        Args:
            session_id: Session identifier

        Returns:
            True if refreshed, False if not found
        """
        session_data = self._sessions.get(session_id)
        if not session_data:
            return False

        # Check if still valid
        expires_at = datetime.fromisoformat(session_data["_expires_at"])
        if datetime.utcnow() > expires_at:
            self.delete_session(session_id)
            return False

        # Refresh expiry
        new_expires_at = datetime.utcnow() + timedelta(seconds=session_config.expiry)
        session_data["_expires_at"] = new_expires_at.isoformat()
        return True

    def get_user_sessions(self, user_id: str) -> list[str]:
        """Get all active session IDs for a user from memory.

        Args:
            user_id: User identifier

        Returns:
            List of active session IDs
        """
        {% if session_config.multi_device %}
        if user_id not in self._user_sessions:
            return []

        # Filter out expired sessions
        active_sessions = []
        for session_id in list(self._user_sessions[user_id]):
            session_data = self._sessions.get(session_id)
            if session_data:
                expires_at = datetime.fromisoformat(session_data["_expires_at"])
                if datetime.utcnow() <= expires_at:
                    active_sessions.append(session_id)
                else:
                    # Clean up expired session
                    self.delete_session(session_id)
            else:
                # Session missing, clean up index
                self._user_sessions[user_id].discard(session_id)

        return active_sessions
        {% else %}
        return []
        {% endif %}

    def delete_user_sessions(self, user_id: str) -> int:
        """Delete all sessions for a user from memory.

        Args:
            user_id: User identifier

        Returns:
            Number of sessions deleted
        """
        session_ids = self.get_user_sessions(user_id)
        deleted_count = 0

        for session_id in session_ids:
            if self.delete_session(session_id):
                deleted_count += 1

        return deleted_count

    def cleanup_expired_sessions(self) -> int:
        """Clean up expired sessions from memory.

        Returns:
            Number of expired sessions deleted
        """
        expired_sessions = []
        for session_id, session_data in self._sessions.items():
            expires_at = datetime.fromisoformat(session_data["_expires_at"])
            if datetime.utcnow() > expires_at:
                expired_sessions.append(session_id)

        for session_id in expired_sessions:
            self.delete_session(session_id)

        return len(expired_sessions)
{% endif %}


# =============================================================================
# FastAPI Dependency for Session Validation
# =============================================================================

async def get_current_session(
    session_id: Optional[str] = Cookie(None, alias="session_id"),
    x_session_id: Optional[str] = Header(None, alias="X-Session-ID"),
) -> Dict[str, Any]:
    """FastAPI dependency to validate and retrieve current session.

    Extracts session ID from either:
    1. Cookie named "session_id" (recommended for browser clients)
    2. Header "X-Session-ID" (for API clients, mobile apps)

    Cookie takes precedence if both are provided.

    Args:
        session_id: Session ID from cookie
        x_session_id: Session ID from header

    Returns:
        Session data dictionary containing user_id and other session fields

    Raises:
        HTTPException: 401 Unauthorized if session is invalid, expired, or missing

    Example:
        >>> from fastapi import FastAPI, Depends
        >>> app = FastAPI()
        >>>
        >>> @app.get("/profile")
        >>> async def get_profile(session: Dict = Depends(get_current_session)):
        ...     user_id = session["user_id"]
        ...     return {"user_id": user_id, "email": session.get("email")}
        >>>
        >>> # Usage with cookie:
        >>> # GET /profile
        >>> # Cookie: session_id=abc123...
        >>>
        >>> # Usage with header:
        >>> # GET /profile
        >>> # X-Session-ID: abc123...
    """
    # Extract session ID from cookie or header
    effective_session_id = session_id or x_session_id

    if not effective_session_id:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="No session provided. Include session_id cookie or X-Session-ID header.",
            headers={"WWW-Authenticate": "Session"},
        )

    # Initialize appropriate session store based on configuration
    {% if session_config.storage == "redis" %}
    # TODO: Configure Redis connection from environment variables
    # redis_client = Redis(host=os.getenv("REDIS_HOST", "localhost"), ...)
    # store = SessionStore(redis_client=redis_client)
    store = SessionStore()  # Uses default localhost connection
    {% elif session_config.storage == "database" %}
    # TODO: Configure database connection from environment variables
    # from sqlalchemy import create_engine
    # engine = create_engine(os.getenv("DATABASE_URL"))
    # store = DatabaseSessionStore(engine)
    raise HTTPException(
        status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
        detail="Database session store not configured. Set up SQLAlchemy engine."
    )
    {% elif session_config.storage == "memory" %}
    # WARNING: Using in-memory sessions - not suitable for production!
    # Create a global instance or use dependency injection
    global _memory_store
    if "_memory_store" not in globals():
        _memory_store = MemorySessionStore()
    store = _memory_store
    {% endif %}

    # Retrieve session data
    session_data = store.get_session(effective_session_id)

    if not session_data:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or expired session. Please log in again.",
            headers={"WWW-Authenticate": "Session"},
        )

    return session_data
