class EventSubscriber:
    """Event subscriber with filtering support.

    Allows subscribers to register interest in specific event types
    and receive only matching events.
    """

    def __init__(
        self,
        subscriber_id: str,
        event_types: Optional[Set[str]] = None,
        custom_filter: Optional[EventFilter] = None,
    ):
        """Initialize an event subscriber.

        Args:
            subscriber_id: Unique identifier for this subscriber
            event_types: Set of event types to subscribe to (e.g., {"order.placed", "order.cancelled"}).
                        If None, subscribes to all events.
            custom_filter: Optional custom filter function that receives (event_name, payload)
                          and returns True if the event should be delivered.
        """
        self.subscriber_id = subscriber_id
        self.event_types = event_types
        self.custom_filter = custom_filter

    def matches(self, event_name: str, payload: Dict[str, Any]) -> bool:
        """Check if an event matches this subscriber's filters.

        Args:
            event_name: Name of the event
            payload: Event payload

        Returns:
            True if the event should be delivered to this subscriber
        """
        # Check event type filter
        if self.event_types is not None and event_name not in self.event_types:
            return False

        # Check custom filter
        if self.custom_filter is not None:
            try:
                if not self.custom_filter(event_name, payload):
                    return False
            except Exception as e:
                logger.warning(
                    f"Custom filter failed for subscriber {self.subscriber_id}: {e}"
                )
                return False

        return True


class EventPublisher:
    """Event publisher with support for multiple channels and subscriber filtering."""

    def __init__(self, redis_client=None, websocket_manager=None):
        """Initialize the event publisher.

        Args:
            redis_client: Redis client for pub/sub (optional)
            websocket_manager: WebSocket connection manager (optional)
        """
        self.redis_client = redis_client
        self.websocket_manager = websocket_manager
        self._subscribers: Dict[str, EventSubscriber] = {}

    def register_subscriber(
        self,
        subscriber_id: str,
        event_types: Optional[Set[str]] = None,
        custom_filter: Optional[EventFilter] = None,
    ) -> EventSubscriber:
        """Register a subscriber with optional event type filtering.

        Args:
            subscriber_id: Unique identifier for the subscriber
            event_types: Set of event types to subscribe to. If None, subscribes to all.
            custom_filter: Optional custom filter function

        Returns:
            The created EventSubscriber instance
        """
        subscriber = EventSubscriber(subscriber_id, event_types, custom_filter)
        self._subscribers[subscriber_id] = subscriber
        logger.info(
            f"Registered subscriber '{subscriber_id}' for events: "
            f"{event_types if event_types else 'all'}"
        )
        return subscriber

    def unregister_subscriber(self, subscriber_id: str) -> bool:
        """Unregister a subscriber.

        Args:
            subscriber_id: ID of the subscriber to remove

        Returns:
            True if subscriber was removed, False if not found
        """
        if subscriber_id in self._subscribers:
            del self._subscribers[subscriber_id]
            logger.info(f"Unregistered subscriber '{subscriber_id}'")
            return True
        return False

    def get_matching_subscribers(
        self, event_name: str, payload: Dict[str, Any]
    ) -> List[EventSubscriber]:
        """Get all subscribers that should receive an event.

        Args:
            event_name: Name of the event
            payload: Event payload

        Returns:
            List of matching subscribers
        """
        return [
            sub for sub in self._subscribers.values()
            if sub.matches(event_name, payload)
        ]

    async def publish(
        self,
        event_name: str,
        payload: Dict[str, Any],
        channels: List[str] = None,
    ):
        """Publish an event to specified channels.

        Args:
            event_name: Name of the event (e.g., "order.placed")
            payload: Event payload dictionary
            channels: List of channels to publish to
        """
        if channels is None:
            channels = []

        # Log event publication for debugging
        logger.info(f"Publishing event '{event_name}' to channels: {channels}")
        logger.debug(f"Event payload: {payload}")

        # Enrich payload with event metadata
        enriched_payload = {
            "event": event_name,
            "timestamp": datetime.utcnow().isoformat(),
            "data": payload,
        }

        # Publish to Redis Pub/Sub
        if "redis-pubsub" in channels or "redis" in channels:
            await self._publish_to_redis(event_name, enriched_payload)

        # Publish to WebSocket
        if "websocket" in channels:
            await self._publish_to_websocket(event_name, enriched_payload)

        # Publish to Push Notifications
        if "push" in channels:
            await self._publish_to_push(event_name, enriched_payload)

        logger.info(
            f"Successfully published event '{event_name}' to {len(channels)} channel(s)"
        )

    async def _publish_to_redis(
        self, event_name: str, payload: Dict[str, Any]
    ):
        """Publish event to Redis Pub/Sub channel.

        Handles Redis connection failures gracefully without crashing the application.
        If Redis is unavailable, the event will still be published to other channels.

        Args:
            event_name: Name of the event
            payload: Event payload with metadata
        """
        if not self.redis_client:
            logger.warning(
                f"Redis client not configured, skipping Redis publish for event '{event_name}'"
            )
            return

        try:
            channel = f"events:{event_name}"
            # Use default=str to handle UUID, datetime, Decimal serialization
            message = json.dumps(payload, default=str)
            await self.redis_client.publish(channel, message)
            logger.debug(f"Successfully published event '{event_name}' to Redis channel: {channel}")
        except ConnectionError as e:
            logger.error(
                f"Redis connection failed for event '{event_name}': {e}. "
                "Event will still be published to other channels."
            )
        except TimeoutError as e:
            logger.error(
                f"Redis timeout for event '{event_name}': {e}. "
                "Event will still be published to other channels."
            )
        except Exception as e:
            logger.error(
                f"Failed to publish event '{event_name}' to Redis: "
                f"{type(e).__name__}: {e}"
            )

    async def _publish_to_websocket(
        self, event_name: str, payload: Dict[str, Any]
    ):
        """Broadcast event to WebSocket clients based on subscriber filtering.

        Events are only sent to subscribers that have registered interest in
        the specific event type. If no subscribers are registered, broadcasts
        to all connected clients.

        Args:
            event_name: Name of the event
            payload: Event payload with metadata
        """
        if not self.websocket_manager:
            logger.warning(
                f"WebSocket manager not configured, skipping event {event_name}"
            )
            return

        try:
            message = json.dumps(payload, default=str)

            # Get matching subscribers for filtered delivery
            matching_subscribers = self.get_matching_subscribers(event_name, payload)

            if self._subscribers and matching_subscribers:
                # Send to specific subscribers only
                for subscriber in matching_subscribers:
                    try:
                        await self.websocket_manager.send_to_subscriber(
                            subscriber.subscriber_id, message
                        )
                        logger.debug(
                            f"Sent event {event_name} to subscriber {subscriber.subscriber_id}"
                        )
                    except Exception as e:
                        logger.warning(
                            f"Failed to send to subscriber {subscriber.subscriber_id}: {e}"
                        )
                logger.debug(
                    f"Delivered event {event_name} to {len(matching_subscribers)} subscriber(s)"
                )
            else:
                # No filtering configured, broadcast to all
                await self.websocket_manager.broadcast(message)
                logger.debug(
                    f"Broadcast event {event_name} to all WebSocket clients"
                )
        except Exception as e:
            logger.error(f"Failed to publish to WebSocket: {e}")

    async def _publish_to_push(
        self, event_name: str, payload: Dict[str, Any]
    ):
        """Send push notification for event.

        Args:
            event_name: Name of the event
            payload: Event payload with metadata
        """
