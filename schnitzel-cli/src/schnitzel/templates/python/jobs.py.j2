def get_workflow_classes() -> list[type]:
    """Get all workflow classes for worker registration.

    Returns:
        List of workflow class types to register with Temporal worker.

    Example:
        ```python
        from temporalio.client import Client
        from temporalio.worker import Worker

        async def main():
            client = await Client.connect("localhost:7233")

            worker = Worker(
                client,
                task_queue="default",
                workflows=get_workflow_classes(),
                activities=[],  # Add your activities here
            )

            await worker.run()
        ```
    """
    return [
        {% for job in jobs %}
        {{ job.class_name }},
        {% endfor %}
    ]


