# =============================================================================
# WebSocket Message Types
# =============================================================================

class WebSocketMessage(BaseModel):
    """Base WebSocket message structure."""

    type: str
    data: Dict[str, Any]
    timestamp: Optional[str] = None
    message_id: Optional[str] = None  # For acknowledgments
    correlation_id: Optional[str] = None  # For request-response pattern


class AckMessage(BaseModel):
    """Acknowledgment message for processed messages."""

    type: str = "ack"
    message_id: str
    status: str = "success"
    timestamp: str


class HeartbeatMessage(BaseModel):
    """Heartbeat/ping message."""

    type: str = "heartbeat"
    timestamp: str

{% if needs_auth %}

class AuthMessage(BaseModel):
    """Authentication message for first-message auth."""

    type: str = "auth"
    token: str
{% endif %}


class ErrorMessage(BaseModel):
    """Error message."""

    type: str = "error"
    error: str
    details: Optional[str] = None


# =============================================================================
# Connection Manager
# =============================================================================

class ConnectionManager:
    """Manages WebSocket connections and message broadcasting."""

    def __init__(self, max_connections_per_user: Optional[int] = None):
        """Initialize the connection manager.

        Args:
            max_connections_per_user: Maximum connections allowed per user (None = unlimited)
        """
        self.active_connections: Dict[str, List[WebSocket]] = {}
        self._heartbeat_tasks: Dict[WebSocket, asyncio.Task] = {}
        self._user_connections: Dict[str, List[WebSocket]] = {}  # Track connections per user
        self.max_connections_per_user = max_connections_per_user

    async def connect(self, websocket: WebSocket, room: str = "default", user_id: Optional[str] = None):
        """Accept and register a new WebSocket connection.

        Args:
            websocket: The WebSocket connection to register
            room: Room/channel identifier for grouping connections
            user_id: Optional user identifier for connection limiting

        Returns:
            True if connection accepted, False if rejected due to limits
        """
        # Check max connections per user if configured
        if user_id and self.max_connections_per_user:
            user_connections = self._user_connections.get(user_id, [])

            if len(user_connections) >= self.max_connections_per_user:
                # Close oldest connection for this user
                oldest = user_connections[0]
                logger.info(
                    f"Max connections ({self.max_connections_per_user}) reached for user {user_id}. "
                    f"Closing oldest connection."
                )
                try:
                    await oldest.close(code=1008, reason="Max connections exceeded")
                except Exception as e:
                    logger.error(f"Error closing oldest connection: {e}")

                # Remove from tracking
                for room_name, connections in self.active_connections.items():
                    if oldest in connections:
                        connections.remove(oldest)
                        break

                user_connections.remove(oldest)

                if oldest in self._heartbeat_tasks:
                    self._heartbeat_tasks[oldest].cancel()
                    del self._heartbeat_tasks[oldest]

        await websocket.accept()

        if room not in self.active_connections:
            self.active_connections[room] = []

        self.active_connections[room].append(websocket)

        # Track user connection
        if user_id:
            if user_id not in self._user_connections:
                self._user_connections[user_id] = []
            self._user_connections[user_id].append(websocket)

        logger.info(f"Client connected to room '{room}'. Total connections: {len(self.active_connections[room])}")

        # Start heartbeat for this connection
        heartbeat_task = asyncio.create_task(self._send_heartbeat(websocket))
        self._heartbeat_tasks[websocket] = heartbeat_task

        return True

    def disconnect(self, websocket: WebSocket, room: str = "default", user_id: Optional[str] = None):
        """Unregister a WebSocket connection.

        Args:
            websocket: The WebSocket connection to unregister
            room: Room/channel identifier
            user_id: Optional user identifier for connection tracking
        """
        if room in self.active_connections and websocket in self.active_connections[room]:
            self.active_connections[room].remove(websocket)
            logger.info(f"Client disconnected from room '{room}'. Remaining connections: {len(self.active_connections[room])}")

            # Clean up empty rooms
            if len(self.active_connections[room]) == 0:
                del self.active_connections[room]

        # Remove from user connections tracking
        if user_id and user_id in self._user_connections:
            if websocket in self._user_connections[user_id]:
                self._user_connections[user_id].remove(websocket)

            # Clean up empty user tracking
            if len(self._user_connections[user_id]) == 0:
                del self._user_connections[user_id]

        # Cancel heartbeat task
        if websocket in self._heartbeat_tasks:
            self._heartbeat_tasks[websocket].cancel()
            del self._heartbeat_tasks[websocket]

    async def send_personal_message(self, message: str, websocket: WebSocket):
        """Send a message to a specific WebSocket connection.

        Args:
            message: The message to send (JSON string)
            websocket: The target WebSocket connection
        """
        try:
            await websocket.send_text(message)
        except Exception as e:
            logger.error(f"Failed to send personal message: {e}")

    async def broadcast(self, message: str, room: str = "default", exclude: Optional[WebSocket] = None):
        """Broadcast a message to all connections in a room.

        Args:
            message: The message to broadcast (JSON string)
            room: Room/channel to broadcast to
            exclude: Optional WebSocket connection to exclude from broadcast
        """
        if room not in self.active_connections:
            logger.warning(f"Attempted to broadcast to non-existent room '{room}'")
            return

        disconnected = []
        for connection in self.active_connections[room]:
            if exclude and connection == exclude:
                continue

            try:
                await connection.send_text(message)
            except Exception as e:
                logger.error(f"Failed to broadcast to connection: {e}")
                disconnected.append(connection)

        # Clean up disconnected clients
        for connection in disconnected:
            self.disconnect(connection, room)

    async def _send_heartbeat(self, websocket: WebSocket, interval: int = 30):
        """Send periodic heartbeat messages to keep connection alive.

        Args:
            websocket: The WebSocket connection
            interval: Heartbeat interval in seconds
        """
        try:
            while True:
                await asyncio.sleep(interval)
                heartbeat = HeartbeatMessage(timestamp=datetime.utcnow().isoformat())
                await websocket.send_text(heartbeat.model_dump_json())
        except asyncio.CancelledError:
            # Task was cancelled during disconnect
            pass
        except Exception as e:
            logger.error(f"Heartbeat error: {e}")


